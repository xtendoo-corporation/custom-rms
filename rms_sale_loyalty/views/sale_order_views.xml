<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_promotions" model="ir.ui.view">
        <field name="name">sale.order.form.rms.promotions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_loyalty.sale_order_view_form_inherit_sale_loyalty"/>
        <field name="arch" type="xml">
            <!-- Cada botón está duplicado (activo y deshabilitado): un xpath solo
                 modifica el primer nodo, así que se trata cada uno por separado. -->
            <xpath expr="(//button[@name='action_open_reward_wizard'])[1]" position="attributes">
                <attribute name="string">Promociones</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_open_reward_wizard'])[2]" position="attributes">
                <attribute name="string">Promociones</attribute>
            </xpath>
            <xpath expr="(//button[@name='%(sale_loyalty.sale_loyalty_coupon_wizard_action)d'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//button[@name='%(sale_loyalty.sale_loyalty_coupon_wizard_action)d'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_open_discount_wizard'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_open_discount_wizard'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
