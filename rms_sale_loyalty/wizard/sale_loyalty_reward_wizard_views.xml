<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_loyalty_reward_wizard_view_form_promotions" model="ir.ui.view">
        <field name="name">sale.loyalty.reward.wizard.form.rms.promotions</field>
        <field name="model">sale.loyalty.reward.wizard</field>
        <field name="inherit_id" ref="sale_loyalty.sale_loyalty_reward_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="replace">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <p invisible="line_ids">No hay promociones disponibles para este presupuesto.</p>
                    <field name="line_ids" nolabel="1" invisible="not line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected"/>
                            <field name="program_name" readonly="1"/>
                            <field name="reward_description" readonly="1"/>
                            <field name="internal_note" readonly="1"/>
                            <field name="multi_product" column_invisible="True"/>
                            <field name="reward_product_ids" column_invisible="True"/>
                            <field name="selected_product_id" invisible="not multi_product" required="multi_product" options="{'no_create': True, 'no_open': True}"/>
                        </list>
                    </field>
                </sheet>
            </xpath>
            <xpath expr="//footer" position="replace">
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary" invisible="not line_ids"/>
                    <button name="action_cancel" type="object" string="Descartar" invisible="not line_ids"/>
                    <button string="Cerrar" special="cancel" class="btn-primary" invisible="line_ids"/>
                </footer>
            </xpath>
        </field>
    </record>
</odoo>
