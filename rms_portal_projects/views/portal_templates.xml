<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_installation_project" name="Mi cuenta: proyectos" inherit_id="portal.portal_my_home" customize_show="True">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="installation_project_count" t-call="portal.portal_docs_entry">
                <t t-set="title">Proyectos</t>
                <t t-set="url" t-value="'/my/projects'"/>
                <t t-set="placeholder_count" t-value="'installation_project_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_installation_projects" name="Mis proyectos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Proyectos</t>
            </t>

            <t t-if="not projects">
                <p>No tienes proyectos disponibles todavía.</p>
            </t>
            <t t-else="">
                <table class="table table-hover o_portal_my_doc_table">
                    <thead>
                        <tr class="active">
                            <th>Referencia</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="projects" t-as="project">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/projects/#{project.id}">
                                        <span t-esc="project.name"/>
                                    </a>
                                </td>
                                <td><span t-field="project.date"/></td>
                                <td>
                                    <span class="badge text-bg-info" t-if="project.state == 'sent'">Enviado</span>
                                    <span class="badge text-bg-success" t-if="project.state == 'accepted'">Aceptado</span>
                                    <span class="badge text-bg-danger" t-if="project.state == 'rejected'">Rechazado</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-call="portal.pager"/>
            </t>
        </t>
    </template>

    <template id="portal_installation_project_page" name="Proyecto">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="o_portal_my_doc_book">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backurl" t-value="'/my/projects'"/>
                </t>
                <h2 t-field="project.name"/>
                <p>
                    Fecha: <span t-field="project.date"/><br/>
                    Estado:
                    <span class="badge text-bg-info" t-if="project.state == 'sent'">Enviado</span>
                    <span class="badge text-bg-success" t-if="project.state == 'accepted'">Aceptado</span>
                    <span class="badge text-bg-danger" t-if="project.state == 'rejected'">Rechazado</span>
                </p>
                <t t-if="project.pdf_file">
                    <a t-attf-href="/my/projects/#{project.id}/pdf" class="btn btn-primary mb-3" target="_blank">
                        <i class="fa fa-download"/> Descargar PDF
                    </a>
                    <iframe t-attf-src="/my/projects/#{project.id}/pdf" style="width: 100%; height: 800px; border: 1px solid #ddd;"/>
                </t>
                <t t-else="">
                    <p class="text-muted">Todavía no hay un PDF adjunto a este proyecto.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>
