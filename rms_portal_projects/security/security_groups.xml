<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_installation_projects" model="ir.module.category">
        <field name="name">Entregar Proyecto (RMS)</field>
    </record>
    <record id="res_groups_privilege_installation_projects" model="res.groups.privilege">
        <field name="name">Entregar Proyecto</field>
        <field name="category_id" ref="module_category_installation_projects"/>
    </record>
    <record id="group_installation_project_manager" model="res.groups">
        <field name="name">Entregar Proyecto: gestor</field>
        <field name="privilege_id" ref="res_groups_privilege_installation_projects"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_installation_project_manager'))]"/>
    </record>
</odoo>
