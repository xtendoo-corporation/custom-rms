<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_installation_project_portal" model="ir.rule">
        <field name="name">Proyecto de instalación: solo el cliente asignado</field>
        <field name="model_id" ref="model_rms_installation_project"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('state', '!=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_installation_project_internal" model="ir.rule">
        <field name="name">Proyecto de instalación: acceso interno completo</field>
        <field name="model_id" ref="model_rms_installation_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>
