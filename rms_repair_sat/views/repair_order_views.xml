<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario estándar de Reparación + datos y botones del SAT -->
    <record id="view_repair_order_form_sat" model="ir.ui.view">
        <field name="name">repair.order.form.rms.sat</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_validate']" position="before">
                <button name="action_rms_register_entry" type="object" string="Registrar entrada" class="oe_highlight"
                        invisible="rms_in_sat or state == 'cancel' or rms_stage == 'delivered'"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_send_factory" type="object" string="Enviar a fábrica"
                        invisible="not rms_in_sat or rms_stage == 'factory' or state == 'cancel'"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_back_from_factory" type="object" string="Recibido de fábrica" class="oe_highlight"
                        invisible="rms_stage != 'factory'" groups="repair_security.group_repair_user"/>
                <button name="action_rms_swap" type="object" string="Cambio en garantía"
                        invisible="not under_warranty or not rms_in_sat or rms_owner_type != 'customer' or rms_swap_done or rms_stage == 'factory'"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_wait_part" type="object" string="Esperando pieza"
                        invisible="rms_stage in ('waiting_part', 'factory', 'delivered', 'uncollected', 'cancel')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_part_received" type="object" string="Pieza recibida"
                        invisible="rms_stage != 'waiting_part'" groups="repair_security.group_repair_user"/>
                <button name="action_rms_deliver" type="object" string="Entregar / enviar al cliente"
                        invisible="not rms_in_sat or rms_stage == 'factory'"
                        class="oe_highlight" groups="repair_security.group_repair_user"
                        confirm="El equipo sale del SAT hacia el cliente. ¿Seguir?"/>
            </xpath>
            <xpath expr="//header/button[@name='action_create_sale_order']" position="after">
                <button name="action_rms_send_quote" type="object" string="Enviar presupuesto"
                        invisible="not sale_order_id or rms_sale_order_state not in ('draft', 'sent')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_reject_quote" type="object" string="Presupuesto rechazado"
                        invisible="not sale_order_id or rms_sale_order_state not in ('draft', 'sent')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_reapprove" type="object" string="Cliente acepta la ampliación"
                        invisible="not rms_needs_reapproval" groups="repair_security.group_repair_user"/>
                <button name="action_rms_add_used_alternative" type="object" string="Añadir alternativa 2ª mano"
                        invisible="not sale_order_id or rms_parts_choice or state in ('done', 'cancel')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_choose_used" type="object" string="Cliente elige 2ª mano"
                        invisible="not sale_order_id or rms_parts_choice or state in ('done', 'cancel')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_choose_new" type="object" string="Cliente elige nuevo"
                        invisible="not sale_order_id or rms_parts_choice or state in ('done', 'cancel')"
                        groups="repair_security.group_repair_user"/>
                <button name="action_rms_print_label" type="object" string="Etiqueta del equipo" invisible="not lot_id"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-danger" role="alert" invisible="not rms_needs_reapproval">
                    El presupuesto supera lo aceptado: hay que pedir nueva aceptación al cliente
                </div>
                <widget name="web_ribbon" title="Atascada" bg_color="text-bg-danger" invisible="not rms_late or rms_stage in ('factory', 'waiting_part')"/>
                <widget name="web_ribbon" title="Revisar plazo" bg_color="text-bg-danger" invisible="not rms_late or rms_stage not in ('factory', 'waiting_part')"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="mb-2">
                    <field name="rms_stage" widget="statusbar" options="{'clickable': '1'}"
                           statusbar_visible="received,diagnosis,quoted,waiting_part,factory,repair,ready,delivered,uncollected"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">rms_owner_type == 'customer'</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="rms_serial_in" invisible="lot_id or rms_in_sat"
                       placeholder="Nº de serie (se da de alta al registrar la entrada)"/>
            </xpath>
            <xpath expr="//field[@name='schedule_date']" position="before">
                <field name="rms_site" required="1" readonly="state != 'draft'"/>
                <field name="rms_owner_type"/>
                <field name="rms_entry_way"/>
                <field name="rms_tracking_ref" invisible="rms_entry_way != 'courier'"/>
            </xpath>
            <xpath expr="//notebook/page[@name='parts']" position="before">
                <page string="Entrada SAT" name="rms_sat">
                    <group>
                        <group string="Recepción">
                            <field name="rms_contact_id" domain="[('id', 'child_of', partner_id)] if partner_id else []"/>
                            <field name="rms_contact_phone"/>
                            <field name="rms_contact_email"/>
                            <field name="rms_fault"/>
                            <field name="rms_intermittent"/>
                            <field name="rms_accessory_ids" widget="many2many_tags"/>
                            <field name="rms_accessories" placeholder="Notas de accesorios"/>
                            <field name="rms_received_by"/>
                            <field name="rms_purchase_ref"/>
                            <field name="rms_needed_by"/>
                            <field name="rms_backup_done"/>
                            <field name="rms_currency_id" invisible="1"/>
                            <field name="rms_max_amount"/>
                            <div colspan="2">Añade al menos una foto desde los archivos adjuntos del chatter antes de registrar la entrada.</div>
                            <field name="rms_in_sat"/>
                            <field name="rms_entry_date"/>
                            <field name="rms_entry_move_id" groups="stock.group_stock_manager"/>
                            <field name="rms_exit_move_id" groups="stock.group_stock_manager"/>
                        </group>
                        <group string="Garantía">
                            <field name="rms_sale_date"/>
                            <field name="rms_warranty_end"/>
                            <field name="rms_warranty_source"/>
                            <div invisible="rms_sale_date" colspan="2">No vendido por nosotros</div>
                        </group>
                        <group string="Cambio en garantía" invisible="not rms_swap_done">
                            <field name="rms_swap_done"/>
                            <field name="rms_swap_date"/>
                            <field name="rms_original_partner_id"/>
                            <field name="lot_id" string="Equipo averiado" invisible="rms_original_lot_id"/>
                            <field name="rms_original_lot_id" string="Equipo averiado" invisible="not rms_original_lot_id"/>
                            <field name="rms_swap_lot_id" string="Equipo entregado"/>
                            <field name="rms_swap_note"/>
                            <field name="rms_swap_picking_id"/>
                        </group>
                        <group string="Presupuesto">
                            <field name="rms_sale_order_state" invisible="1"/>
                            <field name="rms_labour_mode"/>
                            <field name="rms_labour_hours" invisible="rms_labour_mode != 'hourly'"/>
                            <field name="rms_fixed_price_id" invisible="rms_labour_mode != 'fixed'"/>
                            <button name="action_rms_add_labour" type="object" string="Añadir mano de obra"
                                    invisible="not sale_order_id or rms_sale_order_state not in ('draft', 'sent')"
                                    groups="repair_security.group_repair_user"/>
                            <field name="rms_accepted_amount" readonly="1"/>
                            <field name="rms_needs_reapproval" invisible="1"/>
                            <field name="rms_reapproved" readonly="1"/>
                            <field name="rms_rejected_date"/>
                        </group>
                        <group string="Recogida">
                            <field name="rms_delivery_way"/>
                            <field name="rms_delivery_tracking_ref"/>
                        </group>
                        <group string="Tiempos">
                            <field name="rms_stage_date"/>
                            <field name="rms_days_stage"/>
                            <field name="rms_days_total"/>
                            <field name="rms_late" invisible="1"/>
                            <field name="rms_parts_choice"/>
                        </group>
                        <group string="Fábrica (RA)" invisible="not rms_factory_partner_id">
                            <field name="rms_factory_partner_id" readonly="1"/>
                            <field name="rms_rma_number"/>
                            <field name="rms_factory_sent_date"/>
                            <field name="rms_factory_back_date"/>
                            <field name="rms_factory_days"/>
                            <field name="rms_factory_tracking_ref"/>
                            <field name="rms_factory_shipping_cost"/>
                            <field name="rms_factory_note"/>
                            <field name="rms_factory_result"/>
                            <field name="rms_factory_credit_ref" invisible="rms_factory_result != 'credited'"/>
                            <field name="rms_original_lot_id"/>
                            <field name="rms_factory_bill_ids" widget="many2many_tags" domain="[('move_type', '=', 'in_invoice')]"/>
                            <button name="action_rms_add_factory_bill" type="object" string="Repercutir en presupuesto"
                                    invisible="not sale_order_id or rms_sale_order_state not in ('draft', 'sent') or not rms_factory_bill_ids"
                                    groups="repair_security.group_repair_user"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban por fase del SAT -->
    <record id="view_repair_order_kanban_sat" model="ir.ui.view">
        <field name="name">repair.order.kanban.rms.sat</field>
        <field name="model">repair.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <kanban default_group_by="rms_stage" quick_create="false" sample="1" group_create="false"
                    group_delete="false" group_edit="false" records_draggable="1">
                <field name="rms_late"/>
                <field name="rms_stage"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bolder"/>
                            <span t-if="record.rms_late.raw_value" class="badge text-bg-danger"><t t-if="record.rms_stage.raw_value === 'factory' || record.rms_stage.raw_value === 'waiting_part'">Revisar plazo</t><t t-else="">Atascada</t></span>
                        </div>
                        <field name="partner_id"/>
                        <div class="text-muted">
                            <field name="product_id"/>
                            <span t-if="record.lot_id.raw_value"> · <field name="lot_id"/></span>
                        </div>
                        <div class="d-flex justify-content-between mt-1 small">
                            <field name="rms_site"/>
                            <span><field name="rms_days_stage"/> d en fase · <field name="rms_days_total"/> d total</span>
                        </div>
                        <footer>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'draft': 'info', 'cancel': 'danger', 'done': 'success', 'under_repair': 'secondary'}}"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_repair_order_list_sat" model="ir.ui.view">
        <field name="name">repair.order.list.rms.sat</field>
        <field name="model">repair.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list decoration-danger="rms_late" sample="1">
                <field name="name"/>
                <field name="rms_site"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="rms_stage"/>
                <field name="rms_days_stage"/>
                <field name="rms_days_total"/>
                <field name="state" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="rms_late" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_repair_order_list_factory" model="ir.ui.view">
        <field name="name">repair.order.list.rms.factory</field>
        <field name="model">repair.order</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <list decoration-danger="rms_late" create="false">
                <field name="name"/>
                <field name="rms_site"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="rms_factory_partner_id"/>
                <field name="rms_rma_number"/>
                <field name="rms_factory_sent_date"/>
                <field name="rms_factory_days"/>
                <field name="rms_currency_id" column_invisible="1"/>
                <field name="rms_factory_tracking_ref" optional="show"/>
                <field name="rms_factory_shipping_cost" optional="show"/>
                <field name="rms_late" column_invisible="1"/>
                <button name="action_rms_back_from_factory" type="object" string="Recibido de fábrica"
                        class="btn-link" groups="repair_security.group_repair_user"/>
            </list>
        </field>
    </record>

    <record id="view_repair_order_search_sat" model="ir.ui.view">
        <field name="name">repair.order.search.rms.sat</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_id"/>
                <field name="rms_rma_number"/>
                <filter name="rms_open" string="Abiertas en el SAT"
                        domain="[('rms_stage', 'not in', ('delivered', 'cancel'))]"/>
                <filter name="rms_madrid" string="Madrid" domain="[('rms_site', '=', 'madrid')]"/>
                <filter name="rms_sevilla" string="Sevilla" domain="[('rms_site', '=', 'sevilla')]"/>
                <filter name="rms_factory" string="En fábrica" domain="[('rms_stage', '=', 'factory')]"/>
                <filter name="rms_group_stage" string="Fase SAT" context="{'group_by': 'rms_stage'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_rms_sat_repairs" model="ir.actions.act_window">
        <field name="name">Reparaciones SAT</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('view_repair_order_kanban_sat')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_repair_order_list_sat')})]"/>
        <field name="context">{'search_default_rms_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer equipo que entra en el SAT</p>
            <p>Indica los datos de entrada y añade una foto en los archivos adjuntos del chatter antes de registrar la entrada.</p>
        </field>
    </record>

    <record id="action_rms_sat_factory" model="ir.actions.act_window">
        <field name="name">En fábrica</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_repair_order_list_factory"/>
        <field name="domain">[('rms_stage', '=', 'factory')]</field>
    </record>

    <record id="view_rms_repair_stage_limit_list" model="ir.ui.view">
        <field name="name">rms.repair.stage.limit.list</field>
        <field name="model">rms.repair.stage.limit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="stage"/>
                <field name="days" help="Solo avisa; nunca bloquea"/>
            </list>
        </field>
    </record>
    <record id="action_rms_repair_stage_limit" model="ir.actions.act_window">
        <field name="name">Días por fase</field>
        <field name="res_model">rms.repair.stage.limit</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rms_repair_stage_limit_list"/>
        <field name="help" type="html"><p>Solo avisa; nunca bloquea</p></field>
    </record>

    <record id="view_product_category_form_rms_warranty" model="ir.ui.view">
        <field name="name">product.category.form.rms.warranty</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="rms_warranty_months"/>
            </xpath>
        </field>
    </record>

    <!-- Asistente "Enviar a fábrica" -->
    <record id="view_rms_repair_factory_wizard" model="ir.ui.view">
        <field name="name">rms.repair.factory.wizard.form</field>
        <field name="model">rms.repair.factory.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar a fábrica">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="rma_number"/>
                    <field name="date"/>
                    <field name="tracking_ref"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="shipping_cost"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Enviar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_rms_repair_swap_wizard" model="ir.ui.view">
        <field name="name">rms.repair.swap.wizard.form</field>
        <field name="model">rms.repair.swap.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambio en garantía">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="product_id"/>
                    <field name="available_lot_ids" invisible="1"/>
                    <field name="lot_id" domain="[('id', 'in', available_lot_ids)]"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar cambio" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rms_repair_factory_return_wizard" model="ir.ui.view">
        <field name="name">rms.repair.factory.return.wizard.form</field>
        <field name="model">rms.repair.factory.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Recibido de fábrica">
                <group>
                    <field name="repair_id" readonly="1"/>
                    <field name="result"/>
                    <field name="new_serial" invisible="result != 'replaced'" required="result == 'replaced'"/>
                    <field name="credit_ref" invisible="result != 'credited'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_rms_repair_fixed_price_list" model="ir.ui.view">
        <field name="name">rms.repair.fixed.price.list</field>
        <field name="model">rms.repair.fixed.price</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="product_id" domain="[('type', '=', 'service')]"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_rms_repair_fixed_price" model="ir.actions.act_window">
        <field name="name">Tipos de reparación con precio cerrado</field>
        <field name="res_model">rms.repair.fixed.price</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rms_repair_fixed_price_list"/>
    </record>
    <record id="view_stock_lot_form_rms_replaces" model="ir.ui.view">
        <field name="name">stock.lot.form.rms.replaces</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="rms_replaces_lot_id"/>
            </xpath>
        </field>
    </record>
</odoo>
