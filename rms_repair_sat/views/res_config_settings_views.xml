<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rms_sat" model="ir.ui.view">
        <field name="name">res.config.settings.form.rms.sat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_repair_config.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='repair_setting_container']" position="inside">
                <setting string="Garantía por defecto" help="Meses de garantía cuando el producto y la marca no tienen garantía propia.">
                    <field name="rms_sat_default_warranty_months"/>
                </setting>
                <setting string="Condiciones del resguardo" help="Borrador pendiente de revisión del asesor">
                    <field name="rms_sat_receipt_terms" widget="html"/>
                </setting>
                <setting string="Precio de piezas de 2ª mano" help="Fracción del precio nuevo si el lote no tiene precio propio (0,5 = mitad).">
                    <field name="rms_sat_used_price_factor"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
