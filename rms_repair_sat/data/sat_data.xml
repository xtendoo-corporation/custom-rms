<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_late_days" model="ir.config_parameter">
            <field name="key">rms_repair_sat.late_days</field>
            <field name="value">7</field>
        </record>
        <record id="param_used_price_factor" model="ir.config_parameter">
            <field name="key">rms_repair_sat.used_price_factor</field>
            <field name="value">0.5</field>
        </record>
        <record id="seq_rms_disassembly" model="ir.sequence">
            <field name="name">Despiece SAT</field>
            <field name="code">rms.disassembly</field>
            <field name="prefix">DESP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
