<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="param_return_shipping" model="ir.config_parameter">
        <field name="key">rms_repair_sat.default_return_shipping</field>
        <field name="value">collect</field>
    </record>
    <record id="param_reminder_1_days" model="ir.config_parameter">
        <field name="key">rms_repair_sat.reminder_1_days</field><field name="value">30</field>
    </record>
    <record id="param_reminder_2_days" model="ir.config_parameter">
        <field name="key">rms_repair_sat.reminder_2_days</field><field name="value">60</field>
    </record>
    <record id="param_reminder_3_days" model="ir.config_parameter">
        <field name="key">rms_repair_sat.reminder_3_days</field><field name="value">90</field>
    </record>
    <record id="product_sat_shipping" model="product.product">
        <field name="name">Portes SAT</field><field name="type">service</field>
        <field name="sale_ok" eval="True"/><field name="list_price">0</field>
    </record>
    <record id="mail_template_sat_ready" model="mail.template">
        <field name="name">SAT: equipo listo para recoger</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="subject">SAT: equipo listo para recoger - {{ object.name }}</field>
        <field name="email_to">{{ object.rms_contact_id.email or object.partner_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Su equipo está listo para recoger.</p>
                <p>Reparación: <t t-out="object.name"/><br/>
                   Equipo: <t t-out="object.product_id.display_name"/><br/>
                   Nº de serie: <t t-out="object.lot_id.name or object.rms_serial_in or ''"/><br/>
                   Sede: <t t-out="'Madrid' if object.rms_site == 'madrid' else ('Sevilla' if object.rms_site == 'sevilla' else '')"/></p>
                <p>Tiene 3 meses para recogerlo.</p>
            </div>
        </field>
    </record>
    <record id="mail_template_sat_reminder" model="mail.template">
        <field name="name">SAT: recordatorio de recogida</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="subject">SAT: recordatorio de recogida - {{ object.name }}</field>
        <field name="email_to">{{ object.rms_contact_id.email or object.partner_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Le recordamos que tiene un equipo pendiente de recoger.</p>
                <p>Reparación: <t t-out="object.name"/><br/>
                   Equipo: <t t-out="object.product_id.display_name"/><br/>
                   Nº de serie: <t t-out="object.lot_id.name or object.rms_serial_in or ''"/></p>
                <p>Tiene 3 meses para recogerlo.</p>
            </div>
        </field>
    </record>
    <record id="ir_cron_sat_pickup_reminders" model="ir.cron">
        <field name="name">SAT: avisos de recogida</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_rms_pickup_reminders()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
