<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_sat" model="res.groups.privilege">
        <field name="name">SAT</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_sat_warehouse" model="res.groups">
        <field name="name">SAT: Almacén</field>
        <field name="privilege_id" ref="privilege_sat"/>
        <field name="implied_ids" eval="[Command.link(ref('repair_security.group_repair_user'))]"/>
    </record>
    <record id="group_sat_technician" model="res.groups">
        <field name="name">SAT: Técnico</field>
        <field name="privilege_id" ref="privilege_sat"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sat_warehouse'))]"/>
    </record>
    <record id="group_sat_manager" model="res.groups">
        <field name="name">SAT: Responsable</field>
        <field name="privilege_id" ref="privilege_sat"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sat_technician')), Command.link(ref('repair_security.group_repair_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_sat_manager'))]"/>
    </record>
    <record id="rule_sat_staff_repair" model="ir.rule">
        <field name="name">SAT: reparaciones del personal</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="groups" eval="[Command.link(ref('group_sat_warehouse'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_sat_commercial_customer" model="ir.rule">
        <field name="name">SAT: clientes visibles del comercial</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="groups" eval="[Command.link(ref('custom.comerciales'))]"/>
        <!-- Mismo criterio que las reglas de contactos de los comerciales (rms_ventas_restriccion_comerciales):
             clientes propios y los de los comerciales cuya cartera comparte. Sin funciones: Odoo cachea los dominios. -->
        <field name="domain_force">['|', '|',
            ('partner_id.user_id', '=', user.id),
            ('partner_id.commercial_partner_id.user_id', '=', user.id),
            ('partner_id.commercial_partner_id.user_id', 'in', user.rms_shared_customer_user_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
