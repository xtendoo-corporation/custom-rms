<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia del formulario de tarifa (product.pricelist)
         Agrega columnas discount1, discount2, discount3 y discount_active
         dentro del list de item_ids en la pestana Sales Prices. -->
    <record id="product_pricelist_view_form_inherit_triple_discount" model="ir.ui.view">
        <field name="name">product.pricelist.form.triple.discount</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="date_end" position="after">
                <field name="discount1"
                    string="Desc. 1 (%)"
                    optional="show"
                    decoration-warning="discount1 &gt; 0"/>
                <field name="discount2"
                    string="Desc. 2 (%)"
                    optional="show"
                    decoration-warning="discount2 &gt; 0"/>
                <field name="discount3"
                    string="Desc. 3 (%)"
                    optional="show"
                    decoration-warning="discount3 &gt; 0"/>
                <field name="discount_active"
                    string="Desc. Activo"
                    widget="boolean_toggle"
                    optional="show"
                    readonly="1"/>
            </field>
        </field>
    </record>

    <!-- Herencia del formulario individual de regla de tarifa (product.pricelist.item)
         Muestra los tres descuentos en el dialogo de edicion. -->
    <record id="product_pricelist_item_form_inherit_triple_discount" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.triple.discount</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="price_round" position="before">
                <separator string="Descuentos adicionales en cascada"/>
                <group col="3">
                    <field name="discount1" string="Descuento 1 (%)"/>
                    <field name="discount2" string="Descuento 2 (%)"/>
                    <field name="discount3" string="Descuento 3 (%)"/>
                </group>
                <field name="discount_active"
                    string="Descuentos activos"
                    widget="boolean_toggle"
                    readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
