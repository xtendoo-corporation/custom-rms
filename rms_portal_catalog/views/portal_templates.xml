<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_catalog" name="Mi cuenta: catálogo" inherit_id="portal.portal_my_home" customize_show="True">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/mimetypes/document.svg'"/>
                <t t-set="title">Catálogos</t>
                <t t-set="text">Consulta nuestro catálogo de productos</t>
                <t t-set="url" t-value="'/my/catalog'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
</odoo>
