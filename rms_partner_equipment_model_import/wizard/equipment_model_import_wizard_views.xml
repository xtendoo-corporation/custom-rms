<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_model_import_wizard_form" model="ir.ui.view">
        <field name="name">equipment.model.import.wizard.form</field>
        <field name="model">equipment.model.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar modelos de equipo">
                <field name="state" invisible="1"/>
                <group>
                    <field
                        name="excel_file"
                        filename="filename"
                        widget="binary"
                        options="{'accepted_file_extensions': '.xlsx'}"
                        readonly="state == 'preview'"
                    />
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="state == 'preview'">
                    El archivo Excel debe contener las columnas
                    <strong>Account Lookup: Account Name</strong> y
                    <strong>Model: Model Name</strong>.
                </div>
                <group invisible="state != 'preview'">
                    <field name="preview_log" nolabel="1" readonly="1"/>
                </group>
                <group
                    string="Empresas con varias candidatas"
                    invisible="state != 'preview' or not preview_line_ids"
                >
                    <field name="preview_line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="row_number" readonly="1"/>
                            <field name="company_name" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="candidate_partner_ids" invisible="1"/>
                            <field
                                name="selected_partner_id"
                                string="Empresa correcta"
                                domain="[('id', 'in', candidate_partner_ids)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                            <field name="skip_import"/>
                            <field name="candidate_names" readonly="1"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_preview"
                        string="Comprobar"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'preview'"
                    />
                    <button
                        name="action_confirm_import"
                        string="Confirmar importación"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'preview'"
                    />
                    <button
                        name="action_preview"
                        string="Volver a comprobar"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'preview'"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_model_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar modelos de equipo</field>
        <field name="res_model">equipment.model.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
