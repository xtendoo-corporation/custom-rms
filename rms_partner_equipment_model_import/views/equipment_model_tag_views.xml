<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_model_tag_list" model="ir.ui.view">
        <field name="name">equipment.model.tag.list</field>
        <field name="model">equipment.model.tag</field>
        <field name="arch" type="xml">
            <list string="Equipos del Cliente">
                <field name="name"/>
                <field name="partner_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_model_tag_form" model="ir.ui.view">
        <field name="name">equipment.model.tag.form</field>
        <field name="model">equipment.model.tag</field>
        <field name="arch" type="xml">
            <form string="Equipo del Cliente">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <field name="partner_ids" widget="many2many_tags" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_model_tag" model="ir.actions.act_window">
        <field name="name">Equipos del Cliente</field>
        <field name="res_model">equipment.model.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
