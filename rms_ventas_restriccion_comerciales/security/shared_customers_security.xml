<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Traspaso de cartera entre comerciales: además de lo suyo (reglas
         estándar de «Solo sus documentos»), un comercial ve y trabaja los
         contactos, presupuestos y oportunidades de los comerciales cuyos clientes lleva
         también (campo «Lleva también los clientes de» del usuario). Las
         reglas de distintos grupos se suman, así que esto amplía el acceso. -->
    <record id="rule_res_partner_shared_customers" model="ir.rule">
        <field name="name">Contactos de los comerciales cuyos clientes lleva también</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('user_id', 'in', user.rms_shared_customer_user_ids.ids), ('commercial_partner_id.user_id', 'in', user.rms_shared_customer_user_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('custom.comerciales'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Un comercial puede leer los contactos de la empresa cliente de las
         oportunidades y presupuestos que tiene asignados aunque no sea cliente
         suyo (p. ej. una oportunidad que le pasa el administrador): si ve el
         documento, tiene que poder ver su cliente y sus direcciones de
         factura y entrega, o el chatter, el formulario y el presupuesto
         fallan con AccessError (INC-00007). Solo lectura. -->
    <record id="rule_res_partner_assigned_documents" model="ir.rule">
        <field name="name">Contactos de las oportunidades y presupuestos asignados al comercial</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('commercial_partner_id.rms_commercial_crm_lead_ids.user_id', '=', user.id), ('commercial_partner_id.rms_commercial_sale_order_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('custom.comerciales'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_shared_customers" model="ir.rule">
        <field name="name">Presupuestos de los comerciales cuyos clientes lleva también</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('user_id', 'in', user.rms_shared_customer_user_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('custom.comerciales'))]"/>
    </record>

    <record id="rule_sale_order_line_shared_customers" model="ir.rule">
        <field name="name">Líneas de presupuesto de los comerciales cuyos clientes lleva también</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('salesman_id', 'in', user.rms_shared_customer_user_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('custom.comerciales'))]"/>
    </record>

    <record id="rule_crm_lead_shared_customers" model="ir.rule">
        <field name="name">Oportunidades de los comerciales cuyos clientes lleva también</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('user_id', 'in', user.rms_shared_customer_user_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('custom.comerciales'))]"/>
    </record>
</odoo>
