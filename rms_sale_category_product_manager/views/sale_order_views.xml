<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_category_product_managers" model="ir.ui.view">
        <field name="name">sale.order.form.category.product.managers</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="category_product_manager_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
