<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_product_managers" model="ir.ui.view">
        <field name="name">product.category.form.product.managers</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group string="Product Management" name="product_management">
                    <field name="product_manager_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
