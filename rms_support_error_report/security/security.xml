<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_support_error_report" model="ir.module.category">
        <field name="name">Soporte (RMS)</field>
    </record>

    <record id="res_groups_privilege_support_error_report" model="res.groups.privilege">
        <field name="name">Incidencias de soporte</field>
        <field name="category_id" ref="module_category_support_error_report"/>
    </record>

    <record id="group_support_error_report" model="res.groups">
        <field name="name">Recibe incidencias de soporte</field>
        <field name="privilege_id" ref="res_groups_privilege_support_error_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">
            Ve el menú "Incidencias de soporte" con los informes de la IA y
            pertenece automáticamente al canal de Conversaciones "Soporte
            Odoo", donde se avisa de cada error notificado por los usuarios.
        </field>
    </record>
</odoo>
