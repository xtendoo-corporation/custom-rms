<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_search_without_address" model="ir.ui.view">
        <field name="name">res.partner.search.without.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="filter_without_address"
                    string="Sin dirección"
                    domain="[('street', '=', False), ('zip', '=', False), ('city', '=', False), ('state_id', '=', False), ('country_id', '=', False)]"
                />
                <filter
                    name="filter_geo_localize_pending"
                    string="Geolocalización pendiente"
                    domain="[('geo_localize_state', '=', 'pending')]"
                />
                <filter
                    name="filter_geo_localize_failed"
                    string="Geolocalización con error"
                    domain="[('geo_localize_state', '=', 'failed')]"
                />
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_form_geo_localize_state" model="ir.ui.view">
        <field name="name">res.partner.form.geo.localize.state</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='geo_localize_button']" position="before">
                <span>Estado: <field name="geo_localize_state" nolabel="1" readonly="1" class="oe_inline"/></span>
                <br/>
                <span invisible="not geo_localize_error" class="text-danger">
                    <field name="geo_localize_error" nolabel="1" readonly="1" class="oe_inline"/>
                    (<field name="geo_localize_attempts" nolabel="1" readonly="1" class="oe_inline"/> intentos)
                    <br/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_list_geo_localize" model="ir.ui.view">
        <field name="name">res.partner.list.geo.localize</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Geolocalización" editable="bottom" create="0" delete="0">
                <header>
                    <button
                        name="action_geo_localize_retry"
                        type="object"
                        string="Reintentar geolocalización"
                        class="btn-primary"
                    />
                </header>
                <field name="display_name" string="Contacto" readonly="1"/>
                <field name="street"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="state_id" optional="show"/>
                <field name="country_id"/>
                <field name="geo_localize_state" readonly="1" widget="badge"
                    decoration-danger="geo_localize_state == 'failed'"
                    decoration-warning="geo_localize_state == 'pending'"
                    decoration-success="geo_localize_state == 'done'"/>
                <field name="geo_localize_error" readonly="1"/>
                <field name="geo_localize_attempts" readonly="1" optional="show"/>
                <field name="geo_localize_last_try" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="res_partner_view_form_equipment" model="ir.ui.view">
        <field name="name">res.partner.form.equipment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_customer_equipment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-suitcase"
                    invisible="not id"
                >
                    <field
                        name="equipment_count"
                        string="Equipos"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
