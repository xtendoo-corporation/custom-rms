<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_equipment" model="ir.ui.view">
        <field name="name">res.partner.form.equipment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_customer_equipment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-suitcase"
                    invisible="not id"
                >
                    <field
                        name="equipment_count"
                        string="Equipos"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
