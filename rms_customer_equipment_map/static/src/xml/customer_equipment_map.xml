<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rms_customer_equipment_map.CustomerEquipmentMap">
        <div class="o_customer_equipment_map h-100 d-flex flex-column">
            <div class="o_customer_equipment_map_toolbar d-flex align-items-center gap-3 px-3 py-2 border-bottom bg-view">
                <h2 class="mb-0">Mapa de Clientes</h2>
                <Dropdown
                    t-if="state.isAdmin"
                    position="'bottom-start'"
                    beforeOpen.bind="refreshGeoSummary"
                    menuClass="'o_customer_equipment_map_geo_panel p-0'"
                >
                    <button type="button" class="btn btn-secondary d-flex align-items-center gap-2">
                        <i t-att-class="state.geoPolling ? 'fa fa-circle-o-notch fa-spin' : 'fa fa-map-marker'"/>
                        <span>Geolocalización</span>
                        <span
                            t-if="state.geoPolling"
                            class="badge rounded-pill text-bg-info"
                            t-esc="state.geoSummary.pending"
                            title="Pendientes"
                        />
                        <span
                            t-elif="state.geoSummary and state.geoSummary.failed"
                            class="badge rounded-pill text-bg-danger"
                            t-esc="state.geoSummary.failed"
                            title="Con error"
                        />
                        <span
                            t-elif="state.geoSummary and state.geoSummary.pending"
                            class="badge rounded-pill text-bg-warning"
                            t-esc="state.geoSummary.pending"
                            title="Pendientes"
                        />
                    </button>
                    <t t-set-slot="content">
                        <div t-if="state.geoSummary" class="o_customer_equipment_map_geo_panel_body">
                            <div class="px-3 pt-3 pb-2">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <strong>Estado de la geolocalización</strong>
                                    <small class="text-muted"><t t-esc="geoPercent"/>%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div
                                        class="progress-bar bg-success"
                                        role="progressbar"
                                        t-att-style="'width: ' + geoPercent + '%'"
                                    />
                                </div>
                            </div>
                            <DropdownItem
                                t-foreach="geoRows"
                                t-as="row"
                                t-key="row.state"
                                onSelected="() => this.openGeoList(row.state)"
                                class="'o_customer_equipment_map_geo_row d-flex align-items-center gap-2 px-3 py-2'"
                            >
                                <i t-att-class="'fa fa-fw ' + row.icon"/>
                                <span class="flex-grow-1">
                                    <span class="d-block" t-esc="row.label"/>
                                    <small t-if="row.help and row.count" class="d-block text-muted" t-esc="row.help"/>
                                </span>
                                <strong t-esc="row.count"/>
                                <i class="fa fa-angle-right text-muted"/>
                            </DropdownItem>
                            <div class="border-top px-3 py-3">
                                <div class="small text-muted mb-2">
                                    <t t-if="state.geoPolling">
                                        <i class="fa fa-circle-o-notch fa-spin me-1"/>
                                        Geolocalizando en segundo plano… quedan
                                        <strong t-esc="state.geoSummary.pending"/>.
                                        Puedes seguir trabajando.
                                    </t>
                                    <t t-elif="geoNextRunLabel">
                                        <i class="fa fa-calendar me-1"/>
                                        Próxima geolocalización automática:
                                        <strong t-esc="geoNextRunLabel"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        La geolocalización automática está desactivada.
                                    </t>
                                </div>
                                <button
                                    type="button"
                                    class="btn btn-primary w-100"
                                    t-att-disabled="!geoToProcess or state.geoPolling or state.geolocating"
                                    t-on-click="onGeolocateNow"
                                >
                                    <i class="fa fa-refresh me-1"/>
                                    <t t-if="geoToProcess">Geolocalizar <t t-esc="geoToProcess"/> ahora</t>
                                    <t t-else="">Todo está al día</t>
                                </button>
                            </div>
                        </div>
                    </t>
                </Dropdown>
                <div class="ms-auto">
                    <input
                        type="search"
                        class="form-control"
                        placeholder="Buscar cliente, equipo o número de serie..."
                        t-on-input="onSearchInput"
                    />
                </div>
            </div>
            <div class="o_customer_equipment_map_content d-flex flex-grow-1 overflow-hidden">
                <aside class="o_customer_equipment_map_sidebar border-end overflow-auto">
                    <div class="px-3 py-2 text-muted border-bottom">
                        <t t-esc="filteredPartners.length"/> clientes geolocalizados
                    </div>
                    <t t-if="!filteredPartners.length">
                        <div class="p-4 text-center text-muted">
                            No hay clientes geolocalizados que coincidan con la búsqueda.
                        </div>
                    </t>
                    <button
                        t-foreach="visiblePartners"
                        t-as="partner"
                        t-key="partner.id"
                        type="button"
                        class="o_customer_equipment_map_partner w-100 text-start border-0 border-bottom p-3 bg-transparent"
                        t-on-click="() => this.focusPartner(partner.id)"
                    >
                        <strong class="d-block" t-esc="partner.name"/>
                        <small class="d-block text-muted text-truncate" t-esc="partner.address"/>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span t-att-class="'badge rounded-pill o_customer_equipment_map_equipment_badge' + (partner.equipment.length ? '' : ' o_empty')">
                                <t t-esc="partner.equipment.length"/> equipos
                            </span>
                        </div>
                    </button>
                    <div
                        t-if="filteredPartners.length > visiblePartners.length"
                        class="p-3 text-center"
                    >
                        <small class="d-block text-muted mb-2">
                            Mostrando <t t-esc="visiblePartners.length"/> de <t t-esc="filteredPartners.length"/>
                        </small>
                        <button type="button" class="btn btn-link btn-sm" t-on-click="onShowMorePartners">
                            Mostrar más
                        </button>
                    </div>
                </aside>
                <div t-ref="map" class="o_customer_equipment_map_canvas flex-grow-1"/>
            </div>
        </div>
    </t>
</templates>
