<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_employee_certification_own" model="ir.rule">
        <field name="name">Certificaciones de Empleado: ver solo las propias</field>
        <field name="model_id" ref="model_hr_employee_certification"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_hr_employee_certification_hr_officer" model="ir.rule">
        <field name="name">Certificaciones de Empleado: acceso completo RRHH</field>
        <field name="model_id" ref="model_hr_employee_certification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
