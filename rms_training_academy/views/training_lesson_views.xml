<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rms_training_lesson_list" model="ir.ui.view">
        <field name="name">rms.training.lesson.list</field>
        <field name="model">rms.training.lesson</field>
        <field name="arch" type="xml">
            <list decoration-muted="my_state == 'done'">
                <field name="path_id"/>
                <field name="level" widget="badge" decoration-success="level == '1_basic'" decoration-warning="level == '2_intermediate'" decoration-danger="level == '3_advanced'"/>
                <field name="name"/>
                <field name="menu_path" optional="show"/>
                <field name="duration" optional="show" sum="Total"/>
                <field name="access_summary" optional="hide" groups="rms_training_academy.group_training_manager"/>
                <field name="my_state" widget="badge" decoration-success="my_state == 'done'" decoration-info="my_state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_rms_training_lesson_form" model="ir.ui.view">
        <field name="name">rms.training.lesson.form</field>
        <field name="model">rms.training.lesson</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_available" invisible="1"/>
                    <button name="action_start" type="object" string="Empezar lección" class="btn-primary"
                            invisible="my_state != 'not_started' or not is_available"/>
                    <button name="action_mark_done" type="object" string="Marcar como completada" class="btn-primary"
                            invisible="my_state == 'done' or not is_available"/>
                    <button name="action_reset_my_progress" type="object" string="Volver a repasar"
                            invisible="my_state != 'done'"/>
                    <field name="my_state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completada" bg_color="text-bg-success" invisible="my_state != 'done'"/>
                    <div class="alert alert-warning" role="status" invisible="is_available">
                        Con tus permisos actuales no tienes acceso a esta funcionalidad. Puedes leer la lección, pero no
                        cuenta en tu plan de formación. Si la necesitas para tu trabajo, pide acceso a administración.
                    </div>
                    <div class="oe_title">
                        <field name="level" widget="badge" decoration-success="level == '1_basic'" decoration-warning="level == '2_intermediate'" decoration-danger="level == '3_advanced'"/>
                        <h1><field name="name" placeholder="p. ej. Crear un presupuesto"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="path_id"/>
                            <field name="menu_path"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="prerequisite_ids" widget="many2many_tags"/>
                            <field name="done_user_count" groups="rms_training_academy.group_training_manager"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not objective">
                        <strong>Qué aprenderás: </strong><field name="objective" readonly="1" class="d-inline"/>
                    </div>
                    <notebook>
                        <page string="Paso a paso" name="steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="expected_result"/>
                                </list>
                            </field>
                        </page>
                        <page string="Consejos y errores frecuentes" name="tips">
                            <field name="tips"/>
                        </page>
                        <page string="Configuración" name="config" groups="rms_training_academy.group_training_manager">
                            <group string="Quién ve esta lección">
                                <field name="access_summary"/>
                                <field name="module_name"/>
                                <field name="menu_xmlid" placeholder="p. ej. stock_cession.menu_stock_cession"/>
                                <field name="group_xmlids" placeholder="p. ej. base.group_system, custom.comerciales"/>
                            </group>
                            <group string="Otros">
                                <field name="sequence"/>
                                <field name="keywords"/>
                                <field name="active"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rms_training_lesson_search" model="ir.ui.view">
        <field name="name">rms.training.lesson.search</field>
        <field name="model">rms.training.lesson</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('keywords', 'ilike', self), ('menu_path', 'ilike', self)]"/>
                <field name="path_id"/>
                <field name="module_name"/>
                <filter string="Mis lecciones" name="available" domain="[('is_available', '=', True)]"
                        help="Lecciones de las funcionalidades a las que tienes acceso"/>
                <separator/>
                <filter string="Pendientes" name="todo" domain="[('my_state', '=', 'not_started')]"/>
                <filter string="En curso" name="in_progress" domain="[('my_state', '=', 'in_progress')]"/>
                <filter string="Completadas" name="done" domain="[('my_state', '=', 'done')]"/>
                <separator/>
                <filter string="Básico" name="basic" domain="[('level', '=', '1_basic')]"/>
                <filter string="Intermedio" name="intermediate" domain="[('level', '=', '2_intermediate')]"/>
                <filter string="Avanzado" name="advanced" domain="[('level', '=', '3_advanced')]"/>
                <separator/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Aplicación" name="group_path" context="{'group_by': 'path_id'}"/>
                    <filter string="Nivel" name="group_level" context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rms_training_lesson" model="ir.actions.act_window">
        <field name="name">Mi plan de formación</field>
        <field name="res_model">rms.training.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1, 'search_default_group_path': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay lecciones</p>
            <p>Cada lección explica paso a paso cómo hacer algo en vuestro Odoo.
               Quita el filtro "Mis lecciones" para ver también las de otras áreas.</p>
        </field>
    </record>

    <record id="action_rms_training_lesson_todo" model="ir.actions.act_window">
        <field name="name">Mis lecciones pendientes</field>
        <field name="res_model">rms.training.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1, 'search_default_todo': 1, 'search_default_in_progress': 1, 'search_default_group_level': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">¡No tienes lecciones pendientes!</p>
        </field>
    </record>
</odoo>
