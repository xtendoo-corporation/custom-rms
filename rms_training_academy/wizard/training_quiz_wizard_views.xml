<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rms_training_quiz_wizard_form" model="ir.ui.view">
        <field name="name">rms.training.quiz.wizard.form</field>
        <field name="model">rms.training.quiz.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <field name="passed" invisible="1"/>
                <field name="lesson_id" invisible="1"/>
                <div invisible="state != 'answering'">
                    <p class="text-muted">Haz clic en la casilla <strong>Tu respuesta</strong> de cada pregunta, elige una opción y pulsa "Corregir".</p>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="question_id" column_invisible="1"/>
                            <field name="question_text" widget="text" readonly="1"/>
                            <field name="answer_id" options="{'no_create': True, 'no_open': True, 'no_search_more': True}" placeholder="Elige una respuesta..." required="1" width="380px"/>
                        </list>
                    </field>
                </div>
                <div invisible="state != 'result'">
                    <div class="alert alert-success" role="status" invisible="not passed">
                        <strong>¡Aprobado!</strong>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="passed">
                        <strong>Aún no aprobado</strong>
                    </div>
                    <field name="result_message" nolabel="1" class="text-break" style="white-space: pre-wrap;"/>
                </div>
                <footer>
                    <button name="action_submit" type="object" string="Corregir" class="btn-primary"
                            invisible="state != 'answering'"/>
                    <button name="action_retry" type="object" string="Volver a intentarlo" class="btn-primary"
                            invisible="state != 'result' or passed"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
