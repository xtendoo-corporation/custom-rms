# Copiar como /volume1/docker/sage-odoo-sync/.env (permisos 600). NO subir al repositorio.
# Las credenciales de Sage (SAGE_PROD_*) NO van aquí: se leen del .env de la copia
# de los dashboards (/volume1/docker/sync-bi-staging/.env), usuario de SOLO LECTURA.
ODOO_URL=https://erp.rmsproaudio.com
ODOO_DB=rms-sandbox
# Clave API de un usuario técnico de Odoo (solo administración de inventario), con caducidad.
ODOO_API_KEY=
# Opcionales
SAGE_LOTES_DB=LOTES0FT
# SAGE_YEAR_DB=2026FT   (por defecto, el año en curso + FT)
SAGE_COMPANIES=01,02,03
MAX_SECONDS=480
FIRST_RUN_DAYS=45
# Depósitos en vivo: desactivados (0) hasta validar la regla de depósito abierto.
SEND_DEPOSITS=0
