<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rms_stock_count_session.StockCountScan">
        <div class="o_rms_count_scan d-flex flex-column h-100">

            <t t-if="state.step === 'loading'">
                <div class="d-flex align-items-center justify-content-center flex-grow-1">
                    <div class="spinner-border text-primary" role="status"/>
                </div>
            </t>

            <t t-if="state.step === 'error'">
                <div class="p-4">
                    <div class="alert alert-danger" t-esc="state.error"/>
                </div>
            </t>

            <!-- Entrar al recuento con un nombre de operario -->
            <t t-if="state.step === 'join'">
                <div class="p-3 border-bottom">
                    <h4 class="m-0">Recuento <t t-esc="state.session.name"/></h4>
                    <div class="text-muted" t-esc="state.session.location_name"/>
                </div>
                <div class="p-3 flex-grow-1 overflow-auto">
                    <t t-if="state.session.state === 'review' or state.session.state === 'done' or state.session.state === 'cancel'">
                        <div class="alert alert-info">Este recuento ya está cerrado.</div>
                        <button class="btn btn-secondary" t-on-click="backToSession">Volver al recuento</button>
                    </t>
                    <t t-else="">
                        <label class="form-label fw-bold">¿Quién eres?</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control form-control-lg"
                                   placeholder="Tu nombre"
                                   t-att-value="state.joinName"
                                   t-on-input="onJoinNameInput"
                                   t-on-keydown="onJoinKeydown"/>
                            <button class="btn btn-primary btn-lg" t-on-click="() => this.join(state.joinName)">
                                Empezar
                            </button>
                        </div>
                        <t t-if="state.session.operators.length">
                            <div class="text-muted mb-2">O continúa como:</div>
                            <div class="d-flex flex-wrap gap-2">
                                <button t-foreach="state.session.operators" t-as="op" t-key="op.id"
                                        class="btn btn-outline-primary"
                                        t-on-click="() => this.join(op.name)">
                                    <t t-esc="op.name"/>
                                    <span class="badge text-bg-secondary ms-1" t-esc="op.scan_count"/>
                                </button>
                            </div>
                        </t>
                    </t>
                </div>
            </t>

            <!-- Escaneo: pensado para iPad con la pistola. Arriba solo una barra
                 fina (contexto + modos), los estados y el marcador de avance; el
                 resto de la pantalla es la lista compacta de lecturas. -->
            <t t-if="state.step === 'scan' and state.operatorState">
                <t t-set="os" t-value="state.operatorState"/>
                <div class="o_rms_cs_bar o_rms_cs_keep_focus">
                    <button class="btn o_rms_cs_chip o_rms_cs_chip_who" t-on-click="changeOperator"
                            t-att-title="os.session.name + ' · ' + os.operator.name + ' (cambiar de operario)'">
                        <i class="fa fa-user"/><span t-esc="os.operator.name"/>
                    </button>
                    <button class="btn o_rms_cs_chip o_rms_cs_chip_loc"
                            t-att-title="os.location ? os.location.name : 'Elegir ubicación'"
                            t-on-click="() => this.openPanel('location')">
                        <i class="fa fa-map-marker"/><span t-esc="os.location ? os.location.name : os.session.location_name"/>
                    </button>
                    <span class="o_rms_cs_chip_group" t-att-class="os.product ? 'o_rms_cs_has_product' : ''">
                        <button class="btn o_rms_cs_chip"
                                t-att-title="os.product ? os.product.name : 'Elegir producto'"
                                t-on-click="() => this.openPanel('product')">
                            <i class="fa fa-cube"/><span t-esc="os.product ? (os.product.default_code || os.product.name) : 'Producto'"/>
                        </button>
                        <button t-if="os.product" class="btn o_rms_cs_chip_x" title="Quitar producto"
                                aria-label="Quitar producto" t-on-click="clearProduct"><i class="fa fa-times"/></button>
                    </span>
                    <div class="o_rms_cs_modes" role="group" aria-label="Modo de lectura">
                        <button class="btn" t-att-class="state.inputMode === 'pda' ? 'active' : ''"
                                title="Pistola / PDA" aria-label="Pistola" t-on-click="() => this.setInputMode('pda')">
                            <i class="fa fa-barcode"/><span class="o_rms_cs_button_label">PDA</span>
                        </button>
                        <button class="btn" t-att-class="state.inputMode === 'camera' ? 'active' : ''"
                                title="Cámara" aria-label="Cámara" t-on-click="() => this.setInputMode('camera')">
                            <i class="fa fa-camera"/><span class="o_rms_cs_button_label">Cámara</span>
                        </button>
                        <button class="btn" title="Sin etiqueta: imprimir etiqueta sustituta" aria-label="Sin etiqueta"
                                t-on-click="openReplacementLabel">
                            <i class="fa fa-tag"/><span class="o_rms_cs_button_label">Sin etiqueta</span>
                        </button>
                        <button class="btn" title="Buscar en Sage un equipo sin pegatina (p. ej. mesa en flycase)"
                                aria-label="Buscar en Sage" t-on-click="() => this.openPanel('sage')">
                            <i class="fa fa-search"/><span class="o_rms_cs_button_label">Buscar en Sage</span>
                        </button>
                        <button class="btn o_rms_cs_btn_qty" title="Contar por cantidad lo que no lleva nº de serie (cables, fundas, hierros...)"
                                aria-label="Por cantidad" t-on-click="() => this.openPanel('qty')">
                            <i class="fa fa-calculator"/><span class="o_rms_cs_button_label">Por cantidad</span>
                        </button>
                    </div>
                    <!-- Dónde están las lecturas ahora mismo: siempre a la vista. -->
                    <t t-set="save" t-value="saveStatus"/>
                    <button class="btn o_rms_cs_save" t-att-class="'o_rms_cs_save_' + save.kind"
                            role="status" aria-live="polite"
                            t-att-title="save.retry ? 'Toca para reintentar el envío ahora' : save.text"
                            t-on-click="retryNow">
                        <i class="fa" t-att-class="save.icon"/><span t-esc="save.text"/>
                        <span t-if="save.retry" class="o_rms_cs_save_retry"><i class="fa fa-refresh"/><span class="o_rms_cs_save_retry_label"> Reintentar</span></span>
                    </button>
                </div>

                <div t-if="state.conn === 'expired'" class="o_rms_cs_expired o_rms_cs_keep_focus" role="alert">
                    <i class="fa fa-lock"/>
                    <span>Tu sesión ha caducado. Las lecturas están guardadas en este dispositivo.</span>
                    <a class="btn btn-light" t-att-href="loginUrl" t-on-click="onLoginClick">Pulsa aquí para volver a entrar</a>
                </div>

                <div class="o_rms_cs_states o_rms_cs_keep_focus" role="group" aria-label="Estado para las próximas lecturas">
                    <button t-foreach="os.product_states" t-as="productState" t-key="productState.id"
                            class="btn o_rms_cs_state"
                            t-att-class="'o_rms_cs_state_' + productState.code + (os.operator.current_state_id === productState.id ? ' active' : '')"
                            t-att-aria-pressed="os.operator.current_state_id === productState.id ? 'true' : 'false'"
                            t-on-click="() => this.setProductState(productState.id)">
                        <t t-esc="productState.name"/>
                    </button>
                </div>

                <!-- Marcador de avance del almacén Sage donde se cuenta -->
                <t t-set="pg" t-value="state.progress"/>
                <div class="o_rms_cs_progress" role="status" aria-live="polite">
                    <div class="o_rms_cs_progress_site">
                        <t t-if="pg and pg.has_sage"><i class="fa fa-database"/> <t t-esc="pg.site"/></t>
                        <t t-else=""><i class="fa fa-list"/> Este recuento</t>
                    </div>
                    <div class="o_rms_cs_progress_stats">
                        <span t-if="pg and pg.has_sage" class="o_rms_cs_stat o_rms_cs_stat_ok" title="Equipos de Sage de este almacén ya contados">
                            <b t-esc="pg.counted"/> contados</span>
                        <span t-if="pg and pg.has_sage" class="o_rms_cs_stat o_rms_cs_stat_left" title="Equipos de Sage de este almacén que faltan por contar">
                            <b t-esc="pg.pending"/> faltan</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_none" title="Lecturas de este recuento que no están en Sage">
                            <b t-esc="pg ? pg.not_in_sage : 0"/> no en Sage</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_review" title="Lecturas de este recuento para revisar (estado, depósito, duplicado, sin producto)">
                            <b t-esc="pg ? pg.review : 0"/> a revisar</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_mine" title="Lecturas que llevas tú">
                            Llevas <b t-esc="os.operator.scan_count"/></span>
                        <button t-if="pg and pg.qty_pending" class="o_rms_cs_stat o_rms_cs_stat_qty"
                                title="Artículos sin nº de serie que Sage tiene en esta nave y nadie ha apuntado. Toca para contarlos por cantidad."
                                t-on-click="() => this.openPanel('qty')">
                            <b t-esc="pg.qty_pending"/> artículos por cantidad sin contar</button>
                    </div>
                    <div t-if="pg and pg.has_sage and pg.total" class="o_rms_cs_progress_bar">
                        <div t-att-style="'width:' + Math.round(100 * pg.counted / pg.total) + '%'"/>
                    </div>
                </div>

                <div t-if="state.searchMode" class="alert alert-info py-1 px-2 mb-0">Modo búsqueda · solo se tacha escaneando</div>
                <!-- Con la pistola el resultado ya sale en la lista: el aviso solo
                     aparece con la cámara o si pide una decisión (sugerencias). -->
                <div t-if="state.verdict and (state.verdict.suggestionId or state.inputMode !== 'pda')" class="o_rms_cs_verdict" t-att-class="'o_rms_cs_sage_' + state.verdict.kind" role="status" aria-live="polite">
                    <div class="o_rms_cs_verdict_text"><strong><t t-esc="verdictIcon(state.verdict.kind)"/> <t t-esc="state.verdict.text"/></strong><div t-if="state.verdict.detail" t-esc="state.verdict.detail"/></div>
                    <div t-if="state.verdict.suggestionId" class="d-flex gap-2 mt-1 o_rms_cs_keep_focus">
                        <button class="btn btn-dark flex-grow-1" t-on-click="useSuggestion">Sí, es ese</button>
                        <button class="btn btn-outline-dark flex-grow-1" t-on-click="() => { this.state.verdict = null; }">No sé</button>
                    </div>
                </div>
                <!-- Panel de búsqueda de producto / ubicación -->
                <t t-if="state.panel">
                    <div class="p-2 border-bottom">
                        <div class="input-group">
                            <span t-if="state.qtyEditScanId" class="form-control fw-bold border-0">Cambiar la cantidad</span>
                            <input t-else="" type="text" class="form-control" autofocus="autofocus"
                                   autocomplete="off" autocapitalize="off" spellcheck="false"
                                   t-att-placeholder="state.panel === 'location' ? 'Buscar ubicación...' : state.panel === 'sage' ? 'Modelo, nombre, artículo o últimos dígitos del nº de serie...' : state.panel === 'qty' ? 'Parte del nombre o del código (cable, funda, XLR...)' : 'Buscar producto (nombre, referencia, código)...'"
                                   t-att-value="state.panelQuery"
                                   t-on-input="onPanelQueryInput"/>
                            <button class="btn btn-secondary" t-on-click="closePanel">Cerrar</button>
                        </div>
                    </div>
                    <!-- "Por cantidad": artículos sin nº de serie. A ciegas: no se
                         enseña lo que dice Sage, solo lo ya apuntado en este recuento. -->
                    <div t-if="state.panel === 'qty'" class="flex-grow-1 overflow-auto o_rms_cs_qty_panel" t-ref="qtyPanel">
                        <div t-if="!state.qtyEditScanId and !state.qtyPick" class="px-2 py-1 small text-muted">
                            Lo que no lleva nº de serie (cables, fundas, hierros, accesorios): busca el artículo,
                            cuenta las unidades que hay y apunta la cantidad.
                        </div>
                        <div t-if="state.qtyDone" class="o_rms_cs_qty_done" role="status" aria-live="polite">
                            <i class="fa fa-check-circle"/> <t t-esc="state.qtyDone"/>
                        </div>
                        <div t-if="state.qtyPick" class="o_rms_cs_qty_pick">
                            <div class="o_rms_cs_qty_pick_name" t-esc="state.qtyPick.name"/>
                            <div t-if="state.qtyPick.article" class="small text-muted">
                                Sage: <t t-esc="state.qtyPick.article"/><t t-if="state.qtyPick.sage_name"> · <t t-esc="state.qtyPick.sage_name"/></t>
                            </div>
                            <t t-if="!state.qtyPick.ok">
                                <div class="o_rms_cs_qty_blocked" role="alert">
                                    <i class="fa fa-exclamation-triangle"/> Falta crear el producto: avisa al responsable.
                                </div>
                                <div class="o_rms_cs_qty_actions">
                                    <button class="btn btn-outline-secondary btn-lg" t-on-click="clearQtyPick">Otro artículo</button>
                                </div>
                            </t>
                            <t t-else="">
                                <div t-if="!state.qtyEditScanId" class="o_rms_cs_states o_rms_cs_qty_states" role="group" aria-label="Estado de lo que cuentas">
                                    <button t-foreach="os.product_states" t-as="qtyState" t-key="qtyState.id"
                                            class="btn o_rms_cs_state"
                                            t-att-class="'o_rms_cs_state_' + qtyState.code + (state.qtyStateId === qtyState.id ? ' active' : '')"
                                            t-att-aria-pressed="state.qtyStateId === qtyState.id ? 'true' : 'false'"
                                            t-on-click="() => this.setQtyState(qtyState.id)">
                                        <t t-esc="qtyState.name"/>
                                    </button>
                                </div>
                                <div class="o_rms_cs_qty_entry">
                                    <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="5"
                                           autocomplete="off" class="form-control o_rms_cs_qty_input"
                                           placeholder="0" aria-label="Cantidad contada"
                                           t-att-value="state.qtyValue" t-on-input="onQtyInput"/>
                                    <span class="o_rms_cs_qty_unit">unidades</span>
                                </div>
                                <div class="o_rms_cs_qty_keys" role="group" aria-label="Teclado numérico">
                                    <button t-foreach="qtyKeys" t-as="qtyKeyName" t-key="qtyKeyName" class="btn o_rms_cs_qty_key"
                                            t-att-class="qtyKeyName === 'C' or qtyKeyName === 'back' ? 'o_rms_cs_qty_key_fn' : ''"
                                            t-att-aria-label="qtyKeyName === 'back' ? 'Borrar la última cifra' : qtyKeyName === 'C' ? 'Borrar todo' : qtyKeyName"
                                            t-on-click="() => this.qtyKey(qtyKeyName)">
                                        <i t-if="qtyKeyName === 'back'" class="fa fa-long-arrow-left"/>
                                        <t t-else="" t-esc="qtyKeyName"/>
                                    </button>
                                </div>
                                <div t-if="state.qtyConfirm" class="o_rms_cs_qty_confirm" role="alert">
                                    <div class="fw-bold">
                                        Ya hay <t t-esc="formatQty(state.qtyConfirm.existing)"/> apuntadas<t t-if="state.qtyConfirm.by"> (<t t-esc="state.qtyConfirm.by"/>)</t>: ¿sumar o sustituir?
                                    </div>
                                    <div class="o_rms_cs_qty_actions">
                                        <button class="btn btn-success btn-lg" t-att-disabled="state.qtyBusy" t-on-click="() => this.qtySave('add')">
                                            Sumar · total <t t-esc="formatQty(state.qtyConfirm.existing + qtyNumber)"/></button>
                                        <button class="btn btn-warning btn-lg" t-att-disabled="state.qtyBusy" t-on-click="() => this.qtySave('replace')">
                                            Sustituir · quedan <t t-esc="formatQty(qtyNumber)"/></button>
                                        <button class="btn btn-outline-secondary btn-lg" t-on-click="() => { this.state.qtyConfirm = null; }">Cancelar</button>
                                    </div>
                                </div>
                                <div t-else="" class="o_rms_cs_qty_actions">
                                    <button class="btn btn-success btn-lg o_rms_cs_qty_save" t-att-disabled="!qtyNumber or state.qtyBusy"
                                            t-on-click="() => this.qtySave()">
                                        <i class="fa fa-check"/>
                                        <t t-if="state.qtyEditScanId"> Guardar cantidad</t>
                                        <t t-else=""> Apuntar <t t-if="qtyNumber" t-esc="formatQty(qtyNumber)"/></t>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-lg" t-on-click="clearQtyPick">
                                        <t t-if="state.qtyEditScanId">Cancelar</t><t t-else="">Otro artículo</t>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <t t-if="!state.qtyEditScanId">
                            <ul class="list-group list-group-flush">
                                <li t-foreach="state.panelResults" t-as="rec" t-key="rec.key"
                                    class="list-group-item list-group-item-action o_rms_cs_qty_item" style="cursor:pointer"
                                    t-att-class="(state.qtyPick and state.qtyPick.key === rec.key ? 'active' : '') + (rec.ok ? '' : ' o_rms_cs_qty_item_blocked')"
                                    t-on-click="() => this.pickQtyItem(rec)">
                                    <div class="o_rms_cs_qty_item_main">
                                        <span class="fw-bold" t-esc="rec.name"/>
                                        <span t-if="rec.counted" class="o_rms_cs_qty_badge" title="Ya apuntado en este recuento">
                                            × <t t-esc="formatQty(rec.counted)"/></span>
                                    </div>
                                    <div class="small">
                                        <t t-if="rec.ref" t-esc="rec.ref"/>
                                        <t t-if="rec.sage_name and rec.sage_name !== rec.name"> · <t t-esc="rec.sage_name"/></t>
                                        <span t-if="!rec.ok" class="o_rms_cs_qty_flag"> · Falta crear el producto</span>
                                        <span t-elif="!rec.in_sage" class="text-muted"> · no está en Sage en esta nave</span>
                                    </div>
                                </li>
                            </ul>
                            <div t-if="!state.panelResults.length" class="p-3 text-muted">
                                <t t-if="state.panelQuery">Ningún artículo por cantidad con esa búsqueda.</t>
                                <t t-else="">Escribe parte del nombre o del código del artículo.</t>
                            </div>
                        </t>
                    </div>
                    <div t-elif="state.panel === 'sage'" class="flex-grow-1 overflow-auto o_rms_cs_sage_panel">
                        <div class="px-2 py-1 small text-muted">
                            Equipos de Sage de este almacén que aún no se han contado. Elige el que tienes delante:
                            se cuenta y se imprime su etiqueta.
                        </div>
                        <div t-if="state.sagePick" class="o_rms_cs_sage_pick">
                            <div class="fw-bold"><t t-esc="state.sagePick.product_name or state.sagePick.name"/></div>
                            <div class="small">Sage: <t t-esc="state.sagePick.article"/><t t-if="state.sagePick.name"> · <t t-esc="state.sagePick.name"/></t> · <t t-esc="state.sagePick.site"/></div>
                            <div class="o_rms_cs_sage_pick_row">
                                <span class="o_rms_cs_row_serial" t-esc="state.sagePick.serial"/>
                                <select class="form-select form-select-sm" aria-label="Estado"
                                        t-on-change="(ev) => { this.state.sagePickStateId = parseInt(ev.target.value, 10); }">
                                    <option t-foreach="os.product_states" t-as="pickState" t-key="pickState.id"
                                            t-att-value="pickState.id" t-att-selected="pickState.id === state.sagePickStateId"
                                            t-esc="pickState.name"/>
                                </select>
                                <button class="btn btn-success" t-on-click="sagePrintAndCount">
                                    <i class="fa fa-print"/> Imprimir y contar</button>
                                <button class="btn btn-outline-secondary" t-on-click="() => { this.state.sagePick = null; }">Otro</button>
                            </div>
                            <div t-if="!state.sagePick.product_id" class="small text-warning">
                                Este artículo aún no tiene producto en Odoo: se creará con su nombre de Sage.</div>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li t-foreach="state.panelResults" t-as="rec" t-key="rec.id"
                                class="list-group-item list-group-item-action o_rms_cs_sage_item" style="cursor:pointer"
                                t-att-class="state.sagePick and state.sagePick.id === rec.id ? 'active' : ''"
                                t-on-click="() => this.pickSageLine(rec)">
                                <div class="fw-bold" t-esc="rec.name or rec.model"/>
                                <div class="small">
                                    <span class="o_rms_cs_row_serial" t-esc="rec.serial"/> ·
                                    <t t-esc="rec.article"/> · <t t-esc="rec.state_name"/> · <t t-esc="rec.site"/>
                                </div>
                            </li>
                        </ul>
                        <div t-if="!state.panelResults.length" class="p-3 text-muted">Nada pendiente con esa búsqueda.</div>
                        <div class="p-2">
                            <button class="btn btn-outline-primary w-100" t-on-click="sageNotInList">
                                <i class="fa fa-tag"/> No está en la lista: escribir nº de serie</button>
                        </div>
                    </div>
                    <div t-else="" class="flex-grow-1 overflow-auto">
                        <div t-if="state.panel === 'product' and state.assignScan" class="alert alert-info m-2 py-2 o_rms_cs_assign_note">
                            <i class="fa fa-cube"/> Elige el producto del equipo leído <b t-esc="state.assignScan.code"/>. Se le pondrá a esa lectura.
                        </div>
                        <ul class="list-group list-group-flush">
                            <li t-foreach="state.panelResults" t-as="rec" t-key="rec.id"
                                class="list-group-item list-group-item-action" style="cursor:pointer"
                                t-on-click="() => this.pickPanelResult(rec)">
                                <div t-esc="rec.name"/>
                                <small t-if="rec.default_code or rec.barcode" class="text-muted">
                                    <t t-esc="rec.default_code"/> <t t-esc="rec.barcode"/>
                                </small>
                                <span t-if="rec.tracking === 'serial'" class="badge text-bg-light border ms-1">nº serie</span>
                                <span t-if="rec.tracking === 'lot'" class="badge text-bg-light border ms-1">lote</span>
                            </li>
                        </ul>
                        <!-- No existe en Odoo: buscarlo en el catálogo de Sage y crearlo. -->
                        <t t-if="state.panel === 'product'" t-call="rms_stock_count_session.ScanCatalog"/>
                    </div>
                </t>

                <t t-else="">
                    <div class="o_rms_cs_workspace" t-att-class="state.inputMode === 'camera' ? 'o_rms_cs_camera_mode' : ''">
                        <div class="o_rms_cs_capture">
                            <t t-if="state.inputMode === 'camera'">
                                <div class="o_rms_cs_video_wrap">
                                    <video t-ref="video" class="o_rms_cs_video" autoplay="autoplay"
                                           playsinline="playsinline" muted="muted"/>
                                    <div class="o_rms_cs_scan_rect" t-att-style="scanRectStyle"/>
                                </div>
                                <div t-if="state.cameraError" class="alert alert-danger py-2 mt-2 mb-0" t-esc="state.cameraError"/>
                            </t>
                            <div class="o_rms_cs_input o_rms_cs_keep_focus">
                                <input type="text" t-ref="codeInput" class="form-control"
                                       autocomplete="off" autocapitalize="off" spellcheck="false"
                                       t-att-placeholder="state.inputMode === 'pda' ? 'Escanea con la pistola...' : 'Escribir código a mano'"
                                       t-on-keydown="onCodeKeydown" t-on-input="onCodeInput" t-on-blur="onCodeBlur"/>
                                <button class="btn btn-outline-secondary" t-on-click="addTypedCode">Añadir</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!state.history.length"
                                        title="Deshacer la última lectura" aria-label="Deshacer"
                                        t-on-click="() => this.deleteScan(state.history[0].id)">
                                    <i class="fa fa-undo"/><span class="o_rms_cs_button_label">Deshacer</span>
                                </button>
                            </div>
                            <div t-if="state.stuck" class="o_rms_cs_note o_rms_cs_note_warn o_rms_cs_stuck" role="alert">
                                <i class="fa fa-exclamation-triangle"/>
                                <span>Lectura sin procesar: pulsa Añadir o vuelve a leer</span>
                            </div>
                            <div t-if="state.conn === 'offline' or state.conn === 'server' or (state.pending.length and state.queueSlow and state.conn === 'ok')"
                                 class="o_rms_cs_note o_rms_cs_keep_focus o_rms_cs_queue_note"
                                 t-att-class="state.conn === 'offline' ? 'o_rms_cs_note_bad' : 'o_rms_cs_note_warn'" role="status">
                                <i class="fa" t-att-class="state.conn === 'offline' ? 'fa-exclamation-triangle' : 'fa-clock-o'"/>
                                <span>
                                    <t t-if="state.conn === 'offline'">Sin conexión. </t>
                                    <t t-elif="state.conn === 'server'">El servidor está dando errores. </t>
                                    <t t-if="state.pending.length"><t t-esc="state.pending.length"/> lectura(s) pendientes de enviar: están guardadas en este dispositivo y se envían solas.</t>
                                    <t t-else="">Las lecturas nuevas se guardan en este dispositivo y se envían solas al volver.</t>
                                </span>
                                <button class="btn btn-sm btn-dark" t-on-click="retryNow"><i class="fa fa-refresh"/> Reintentar ahora</button>
                            </div>
                            <button t-if="state.audioLocked" class="o_rms_cs_note o_rms_cs_note_quiet o_rms_cs_audio_note" t-on-click="_onGesture">
                                <i class="fa fa-volume-off"/>
                                <span>Toca la pantalla para activar el sonido</span>
                            </button>
                        </div>
                        <!-- Debajo de la casilla: "Lecturas" (lo que llevas, la de siempre)
                             o "Lista" (todo lo que Sage dice que hay en la nave). La
                             pistola lee igual en las dos. -->
                        <div class="o_rms_cs_content">
                        <div class="o_rms_cs_views o_rms_cs_keep_focus">
                            <div class="o_rms_cs_tabs" role="tablist" aria-label="Qué se ve debajo">
                                <button class="btn o_rms_cs_tab_scans" role="tab" t-att-class="state.view !== 'list' ? 'active' : ''"
                                        t-att-aria-selected="state.view !== 'list' ? 'true' : 'false'"
                                        title="Lo que llevas leído" t-on-click="() => this.setView('scans')">
                                    <i class="fa fa-barcode"/> Lecturas
                                </button>
                                <button class="btn o_rms_cs_tab_list" role="tab" t-att-class="state.view === 'list' ? 'active' : ''"
                                        t-att-aria-selected="state.view === 'list' ? 'true' : 'false'"
                                        title="Todo lo que Sage dice que hay en esta nave, y lo que falta" t-on-click="() => this.setView('list')">
                                    <i class="fa fa-list-ul"/> Lista
                                </button>
                            </div>
                            <t t-if="state.view === 'list'" t-call="rms_stock_count_session.ScanListToolbar"/>
                        </div>
                        <t t-if="state.view === 'list'" t-call="rms_stock_count_session.ScanList"/>
                        <section t-else="" class="o_rms_cs_readings" aria-label="Equipos leídos">
                            <div class="o_rms_cs_readings_scroll" t-ref="readingsScroll">
                                <!-- Lecturas que el servidor rechaza: a la vista hasta reintentar o descartar. -->
                                <div t-if="state.failed.length" class="o_rms_cs_failed o_rms_cs_keep_focus" role="alert">
                                    <div class="o_rms_cs_failed_head">
                                        <span><i class="fa fa-exclamation-circle"/> Lecturas con error: revisar (<t t-esc="state.failed.length"/>)</span>
                                        <button t-if="state.failed.length > 1" class="btn btn-sm btn-outline-danger" t-on-click="retryAllFailed">Reintentar todas</button>
                                    </div>
                                    <div t-foreach="state.failed" t-as="bad" t-key="bad.uid" class="o_rms_cs_failed_row">
                                        <div class="o_rms_cs_failed_text">
                                            <span class="o_rms_cs_row_serial" t-esc="itemCode(bad)"/>
                                            <span class="o_rms_cs_failed_error" t-esc="bad.error"/>
                                        </div>
                                        <button class="btn btn-danger" t-on-click="() => this.retryFailed(bad.uid)"><i class="fa fa-refresh"/> Reintentar</button>
                                        <button class="btn btn-outline-secondary" t-on-click="() => this.discardFailed(bad.uid)">Descartar</button>
                                    </div>
                                </div>
                                <div t-if="!state.history.length and !state.pending.length and !state.failed.length" class="p-3 text-muted">Aún no hay equipos leídos. Dispara a un número de serie.</div>
                                <ul class="o_rms_cs_rows">
                                    <!-- Leído pero aún sin confirmar por el servidor: gris con reloj. -->
                                    <li t-foreach="pendingRows" t-as="wait" t-key="'p' + wait.uid" class="o_rms_cs_row o_rms_cs_row_pending">
                                        <div class="o_rms_cs_row_main">
                                            <span class="o_rms_cs_row_icon" aria-hidden="true"><i class="fa fa-clock-o"/></span>
                                            <span class="o_rms_cs_row_model o_rms_cs_row_noproduct">Pendiente de enviar</span>
                                            <span class="o_rms_cs_row_serial" t-esc="itemCode(wait)"/>
                                            <span class="o_rms_cs_row_reason">
                                                <t t-if="state.sendingUid === wait.uid and state.conn === 'ok'">Enviando…</t>
                                                <t t-else="">Guardado en este dispositivo</t>
                                            </span>
                                        </div>
                                        <div class="o_rms_cs_row_state"/>
                                    </li>
                                    <t t-foreach="visibleRows" t-as="scan" t-key="scan.id">
                                        <t t-set="kind" t-value="verdictKind({scan: scan})"/>
                                        <t t-set="repeated" t-value="state.dupId === scan.id"/>
                                        <li class="o_rms_cs_row"
                                            t-att-class="'o_rms_cs_k_' + kind + (scan_first ? ' o_rms_cs_row_last' : '') + (state.expandedId === scan.id ? ' o_rms_cs_row_open' : '') + (repeated ? ' o_rms_cs_row_repeated' : '')">
                                            <div class="o_rms_cs_row_main" t-on-click="() => this.toggleRow(scan.id)">
                                                <span class="o_rms_cs_row_icon" aria-hidden="true" t-esc="verdictIcon(kind)"/>
                                                <span class="o_rms_cs_row_model" t-att-class="scan.product_name ? '' : 'o_rms_cs_row_noproduct'"
                                                      t-esc="shortModel(scan)" t-att-title="scan.product_name or scan.code"/>
                                                <span class="o_rms_cs_row_serial" t-esc="scan.lot_name or scan.code"/>
                                                <span class="o_rms_cs_row_reason">
                                                    <span t-if="repeated" class="o_rms_cs_repeated_badge" role="status">Ya leído</span>
                                                    <t t-esc="shortReason(scan, kind)"/>
                                                </span>
                                            </div>
                                            <div class="o_rms_cs_row_state o_rms_cs_keep_focus">
                                                <select t-if="['serial', 'product'].includes(scan.type)" class="form-select form-select-sm"
                                                        aria-label="Estado de esta lectura"
                                                        t-on-change="(ev) => this.changeScanState(scan.id, ev.target.value)">
                                                    <option t-foreach="os.product_states" t-as="rowState" t-key="rowState.id"
                                                            t-att-value="rowState.id" t-att-selected="rowState.id === scan.product_state_id"
                                                            t-esc="rowState.name"/>
                                                </select>
                                                <span t-else="" class="o_rms_cs_row_state_text" t-esc="scan.product_state_name"/>
                                            </div>
                                            <!-- Coincidencia probable con Sage: "¿Es este?" siempre a la vista. -->
                                            <t t-if="kind === 'prob'" t-call="rms_stock_count_session.ScanMatchAsk"/>
                                            <div t-if="state.expandedId === scan.id" class="o_rms_cs_row_detail o_rms_cs_keep_focus">
                                                <t t-set="full" t-value="verdictFor({scan: scan})"/>
                                                <div t-if="scan.product_name"><span class="text-muted">Odoo:</span> <b t-esc="scan.product_name"/></div>
                                                <div t-else="" class="fw-bold" t-esc="scan.code"/>
                                                <div t-if="scan.sage and (scan.sage.sa or scan.sage.sn)">
                                                    <span class="text-muted">Sage:</span> <t t-esc="scan.sage.sa"/><t t-if="scan.sage.sn"> · <t t-esc="scan.sage.sn"/></t>
                                                </div>
                                                <div t-if="full.text"><t t-esc="full.text"/><t t-if="full.detail"> · <t t-esc="full.detail"/></t></div>
                                                <div t-if="scan.moved_after" class="fw-bold text-warning-emphasis">Sage después: <t t-esc="scan.moved_after"/></div>
                                                <div t-if="scan.type === 'unknown'"><strong>Pendiente de revisar: </strong><t t-esc="scan.message"/></div>
                                                <div t-elif="scan.message and scan.message !== full.text" class="text-muted" t-esc="scan.message"/>
                                                <div class="o_rms_cs_row_actions">
                                                    <span class="text-muted">Leído a las <t t-esc="scan.time"/> · código <t t-esc="scan.code"/></span>
                                                    <button t-if="scan.type === 'serial' and scan.product_name and (scan.lot_name or scan.code)"
                                                            class="btn btn-sm btn-outline-primary" title="Imprimir la etiqueta de este equipo"
                                                            t-on-click="() => this.printScanLabel(scan.id)"><i class="fa fa-print"/> Imprimir etiqueta</button>
                                                    <button t-if="scan.type === 'product'"
                                                            class="btn btn-sm btn-outline-primary" title="Corregir la cantidad apuntada"
                                                            t-on-click="() => this.openQtyEdit(scan)"><i class="fa fa-pencil"/> Cambiar cantidad</button>
                                                    <button t-if="scan.type === 'unknown' and kind !== 'prob'"
                                                            class="btn btn-sm btn-outline-primary o_rms_cs_pick_product" title="Elegir el producto de este equipo (no hace falta volver a leerlo)"
                                                            t-on-click="() => this.openAssignProduct(scan)"><i class="fa fa-cube"/> Elegir producto</button>
                                                    <button class="btn btn-sm btn-outline-danger" title="Borrar lectura"
                                                            t-on-click="() => this.deleteScan(scan.id)"><i class="fa fa-trash"/> Borrar</button>
                                                </div>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </section>
                        </div>
                    </div>
                    <div class="o_rms_cs_footer o_rms_cs_keep_focus">
                        <button class="btn btn-secondary" t-on-click="backToSession">Salir</button>
                        <button class="btn btn-success flex-grow-1" t-on-click="finish">He terminado mi recorrido</button>
                    </div>
                </t>
            </t>

            <t t-if="state.step === 'finished'">
                <div class="p-4 text-center">
                    <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                    <h4>Recorrido terminado</h4>
                    <div t-if="state.missing" class="text-start o_rms_cs_missing">
                        <t t-if="state.missing.scope === 'site'">
                            <h5>FALTAN <t t-esc="state.missing.count || 0"/> equipos de Sage en <t t-esc="state.missing.site"/></h5>
                            <div class="text-muted mb-2">Es el mismo número que el marcador de la nave: equipos con nº de serie que nadie ha leído todavía.</div>
                            <div t-if="state.missing.truncated" class="text-muted mb-2">Se enseñan los primeros de la lista.</div>
                        </t>
                        <t t-else="">
                            <h5>FALTAN <t t-esc="state.missing.count || 0"/> de la zona de este recuento (Sage <t t-esc="state.missing.site"/>)</h5>
                            <div t-if="state.missing.site_pending !== null and state.missing.site_pending !== undefined and state.missing.site_pending !== state.missing.count"
                                 class="text-muted mb-2">
                                En toda la nave (<t t-esc="state.missing.site_name"/>) el marcador dice que faltan <b t-esc="state.missing.site_pending"/> equipos con nº de serie:
                                es otra cuenta, incluye lo que no es de la zona de este recuento.
                            </div>
                        </t>
                        <ul class="list-group mb-3">
                            <li t-foreach="state.missing.missing || []" t-as="item" t-key="item_index" class="list-group-item">
                                <strong t-esc="item.model"/>
                                <div t-if="item.count_by_quantity">contar</div>
                                <div t-foreach="item.serials || []" t-as="serial" t-key="serial_index" t-esc="serial"/>
                            </li>
                        </ul>
                        <button t-if="state.operatorState and state.operatorState.session.state === 'counting'" class="btn btn-primary w-100 mb-3" t-on-click="startSearch">Ir a buscar</button>
                    </div>
                    <p class="text-muted">
                        Tus lecturas están guardadas. Cuando todos terminen, el responsable pulsa
                        "Terminar recuento y cruzar" en el recuento.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button t-if="state.operatorState and state.operatorState.session.state === 'counting'"
                                class="btn btn-outline-primary"
                                t-on-click="() => this.join(state.operatorState.operator.name)">
                            Seguir escaneando
                        </button>
                        <button class="btn btn-primary" t-on-click="backToSession">Volver al recuento</button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
