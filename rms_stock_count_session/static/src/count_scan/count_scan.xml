<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rms_stock_count_session.StockCountScan">
        <div class="o_rms_count_scan d-flex flex-column h-100">

            <t t-if="state.step === 'loading'">
                <div class="d-flex align-items-center justify-content-center flex-grow-1">
                    <div class="spinner-border text-primary" role="status"/>
                </div>
            </t>

            <t t-if="state.step === 'error'">
                <div class="p-4">
                    <div class="alert alert-danger" t-esc="state.error"/>
                </div>
            </t>

            <!-- Entrar al recuento con un nombre de operario -->
            <t t-if="state.step === 'join'">
                <div class="p-3 border-bottom">
                    <h4 class="m-0">Recuento <t t-esc="state.session.name"/></h4>
                    <div class="text-muted" t-esc="state.session.location_name"/>
                </div>
                <div class="p-3 flex-grow-1 overflow-auto">
                    <t t-if="state.session.state === 'review' or state.session.state === 'done' or state.session.state === 'cancel'">
                        <div class="alert alert-info">Este recuento ya está cerrado.</div>
                        <button class="btn btn-secondary" t-on-click="backToSession">Volver al recuento</button>
                    </t>
                    <t t-else="">
                        <label class="form-label fw-bold">¿Quién eres?</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control form-control-lg"
                                   placeholder="Tu nombre"
                                   t-att-value="state.joinName"
                                   t-on-input="onJoinNameInput"
                                   t-on-keydown="onJoinKeydown"/>
                            <button class="btn btn-primary btn-lg" t-on-click="() => this.join(state.joinName)">
                                Empezar
                            </button>
                        </div>
                        <t t-if="state.session.operators.length">
                            <div class="text-muted mb-2">O continúa como:</div>
                            <div class="d-flex flex-wrap gap-2">
                                <button t-foreach="state.session.operators" t-as="op" t-key="op.id"
                                        class="btn btn-outline-primary"
                                        t-on-click="() => this.join(op.name)">
                                    <t t-esc="op.name"/>
                                    <span class="badge text-bg-secondary ms-1" t-esc="op.scan_count"/>
                                </button>
                            </div>
                        </t>
                    </t>
                </div>
            </t>

            <!-- Escaneo: pensado para iPad con la pistola. Arriba solo una barra
                 fina (contexto + modos), los estados y el marcador de avance; el
                 resto de la pantalla es la lista compacta de lecturas. -->
            <t t-if="state.step === 'scan' and state.operatorState">
                <t t-set="os" t-value="state.operatorState"/>
                <div class="o_rms_cs_bar o_rms_cs_keep_focus">
                    <button class="btn o_rms_cs_chip o_rms_cs_chip_who" t-on-click="changeOperator"
                            t-att-title="os.session.name + ' · ' + os.operator.name + ' (cambiar de operario)'">
                        <i class="fa fa-user"/><span t-esc="os.operator.name"/>
                    </button>
                    <button class="btn o_rms_cs_chip o_rms_cs_chip_loc"
                            t-att-title="os.location ? os.location.name : 'Elegir ubicación'"
                            t-on-click="() => this.openPanel('location')">
                        <i class="fa fa-map-marker"/><span t-esc="os.location ? os.location.name : os.session.location_name"/>
                    </button>
                    <span class="o_rms_cs_chip_group" t-att-class="os.product ? 'o_rms_cs_has_product' : ''">
                        <button class="btn o_rms_cs_chip"
                                t-att-title="os.product ? os.product.name : 'Elegir producto'"
                                t-on-click="() => this.openPanel('product')">
                            <i class="fa fa-cube"/><span t-esc="os.product ? (os.product.default_code || os.product.name) : 'Producto'"/>
                        </button>
                        <button t-if="os.product" class="btn o_rms_cs_chip_x" title="Quitar producto"
                                aria-label="Quitar producto" t-on-click="clearProduct"><i class="fa fa-times"/></button>
                    </span>
                    <div class="o_rms_cs_modes" role="group" aria-label="Modo de lectura">
                        <button class="btn" t-att-class="state.inputMode === 'pda' ? 'active' : ''"
                                title="Pistola / PDA" aria-label="Pistola" t-on-click="() => this.setInputMode('pda')">
                            <i class="fa fa-barcode"/><span class="o_rms_cs_button_label">PDA</span>
                        </button>
                        <button class="btn" t-att-class="state.inputMode === 'camera' ? 'active' : ''"
                                title="Cámara" aria-label="Cámara" t-on-click="() => this.setInputMode('camera')">
                            <i class="fa fa-camera"/><span class="o_rms_cs_button_label">Cámara</span>
                        </button>
                        <button class="btn" title="Sin etiqueta: imprimir etiqueta sustituta" aria-label="Sin etiqueta"
                                t-on-click="openReplacementLabel">
                            <i class="fa fa-tag"/><span class="o_rms_cs_button_label">Sin etiqueta</span>
                        </button>
                    </div>
                </div>

                <div class="o_rms_cs_states o_rms_cs_keep_focus" role="group" aria-label="Estado para las próximas lecturas">
                    <button t-foreach="os.product_states" t-as="productState" t-key="productState.id"
                            class="btn o_rms_cs_state"
                            t-att-class="'o_rms_cs_state_' + productState.code + (os.operator.current_state_id === productState.id ? ' active' : '')"
                            t-att-aria-pressed="os.operator.current_state_id === productState.id ? 'true' : 'false'"
                            t-on-click="() => this.setProductState(productState.id)">
                        <t t-esc="productState.name"/>
                    </button>
                </div>

                <!-- Marcador de avance del almacén Sage donde se cuenta -->
                <t t-set="pg" t-value="state.progress"/>
                <div class="o_rms_cs_progress" role="status" aria-live="polite">
                    <div class="o_rms_cs_progress_site">
                        <t t-if="pg and pg.has_sage"><i class="fa fa-database"/> <t t-esc="pg.site"/></t>
                        <t t-else=""><i class="fa fa-list"/> Este recuento</t>
                    </div>
                    <div class="o_rms_cs_progress_stats">
                        <span t-if="pg and pg.has_sage" class="o_rms_cs_stat o_rms_cs_stat_ok" title="Equipos de Sage de este almacén ya contados">
                            <b t-esc="pg.counted"/> contados</span>
                        <span t-if="pg and pg.has_sage" class="o_rms_cs_stat o_rms_cs_stat_left" title="Equipos de Sage de este almacén que faltan por contar">
                            <b t-esc="pg.pending"/> faltan</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_none" title="Lecturas de este recuento que no están en Sage">
                            <b t-esc="pg ? pg.not_in_sage : 0"/> no en Sage</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_review" title="Lecturas de este recuento para revisar (estado, depósito, duplicado, sin producto)">
                            <b t-esc="pg ? pg.review : 0"/> a revisar</span>
                        <span class="o_rms_cs_stat o_rms_cs_stat_mine" title="Lecturas que llevas tú">
                            Llevas <b t-esc="os.operator.scan_count"/></span>
                    </div>
                    <div t-if="pg and pg.has_sage and pg.total" class="o_rms_cs_progress_bar">
                        <div t-att-style="'width:' + Math.round(100 * pg.counted / pg.total) + '%'"/>
                    </div>
                </div>

                <div t-if="state.searchMode" class="alert alert-info py-1 px-2 mb-0">Modo búsqueda · solo se tacha escaneando</div>
                <!-- Con la pistola el resultado ya sale en la lista: el aviso solo
                     aparece con la cámara o si pide una decisión (sugerencias). -->
                <div t-if="state.verdict and (state.verdict.suggestionId or state.inputMode !== 'pda')" class="o_rms_cs_verdict" t-att-class="'o_rms_cs_sage_' + state.verdict.kind" role="status" aria-live="polite">
                    <div class="o_rms_cs_verdict_text"><strong><t t-esc="verdictIcon(state.verdict.kind)"/> <t t-esc="state.verdict.text"/></strong><div t-if="state.verdict.detail" t-esc="state.verdict.detail"/></div>
                    <div t-if="state.verdict.suggestionId" class="d-flex gap-2 mt-1 o_rms_cs_keep_focus">
                        <button class="btn btn-dark flex-grow-1" t-on-click="useSuggestion">Sí, es ese</button>
                        <button class="btn btn-outline-dark flex-grow-1" t-on-click="() => { this.state.verdict = null; }">No sé</button>
                    </div>
                </div>
                <!-- Panel de búsqueda de producto / ubicación -->
                <t t-if="state.panel">
                    <div class="p-2 border-bottom">
                        <div class="input-group">
                            <input type="text" class="form-control" autofocus="autofocus"
                                   t-att-placeholder="state.panel === 'location' ? 'Buscar ubicación...' : 'Buscar producto (nombre, referencia, código)...'"
                                   t-att-value="state.panelQuery"
                                   t-on-input="onPanelQueryInput"/>
                            <button class="btn btn-secondary" t-on-click="closePanel">Cerrar</button>
                        </div>
                    </div>
                    <div class="flex-grow-1 overflow-auto">
                        <ul class="list-group list-group-flush">
                            <li t-foreach="state.panelResults" t-as="rec" t-key="rec.id"
                                class="list-group-item list-group-item-action" style="cursor:pointer"
                                t-on-click="() => this.pickPanelResult(rec)">
                                <div t-esc="rec.name"/>
                                <small t-if="rec.default_code or rec.barcode" class="text-muted">
                                    <t t-esc="rec.default_code"/> <t t-esc="rec.barcode"/>
                                </small>
                                <span t-if="rec.tracking === 'serial'" class="badge text-bg-light border ms-1">nº serie</span>
                                <span t-if="rec.tracking === 'lot'" class="badge text-bg-light border ms-1">lote</span>
                            </li>
                        </ul>
                    </div>
                </t>

                <t t-else="">
                    <div class="o_rms_cs_workspace" t-att-class="state.inputMode === 'camera' ? 'o_rms_cs_camera_mode' : ''">
                        <div class="o_rms_cs_capture">
                            <t t-if="state.inputMode === 'camera'">
                                <div class="o_rms_cs_video_wrap">
                                    <video t-ref="video" class="o_rms_cs_video" autoplay="autoplay"
                                           playsinline="playsinline" muted="muted"/>
                                    <div class="o_rms_cs_scan_rect" t-att-style="scanRectStyle"/>
                                </div>
                                <div t-if="state.cameraError" class="alert alert-danger py-2 mt-2 mb-0" t-esc="state.cameraError"/>
                            </t>
                            <div class="o_rms_cs_input o_rms_cs_keep_focus">
                                <input type="text" t-ref="codeInput" class="form-control"
                                       autocomplete="off" autocapitalize="off" spellcheck="false"
                                       t-att-placeholder="state.inputMode === 'pda' ? 'Escanea con la pistola...' : 'Escribir código a mano'"
                                       t-on-keydown="onCodeKeydown" t-on-input="onCodeInput" t-on-blur="onCodeBlur"/>
                                <button class="btn btn-outline-secondary" t-on-click="addTypedCode">Añadir</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!state.history.length"
                                        title="Deshacer la última lectura" aria-label="Deshacer"
                                        t-on-click="() => this.deleteScan(state.history[0].id)">
                                    <i class="fa fa-undo"/><span class="o_rms_cs_button_label">Deshacer</span>
                                </button>
                            </div>
                            <div t-if="state.offline or state.pending.length" class="alert alert-warning py-1 mt-1 mb-0">
                                <i class="fa fa-wifi me-1"/>
                                <t t-if="state.offline">Sin conexión. </t>
                                <t t-esc="state.pending.length"/> lectura(s) pendientes de enviar.
                            </div>
                        </div>
                        <section class="o_rms_cs_readings" aria-label="Equipos leídos">
                            <div class="o_rms_cs_readings_scroll">
                                <div t-if="!state.history.length" class="p-3 text-muted">Aún no hay equipos leídos. Dispara a un número de serie.</div>
                                <ul class="o_rms_cs_rows">
                                    <t t-foreach="state.history.filter((s) => s.type !== 'product_ref')" t-as="scan" t-key="scan.id">
                                        <t t-set="kind" t-value="verdictKind({scan: scan})"/>
                                        <li class="o_rms_cs_row"
                                            t-att-class="'o_rms_cs_k_' + kind + (scan_first ? ' o_rms_cs_row_last' : '') + (state.expandedId === scan.id ? ' o_rms_cs_row_open' : '')">
                                            <div class="o_rms_cs_row_main" t-on-click="() => this.toggleRow(scan.id)">
                                                <span class="o_rms_cs_row_icon" aria-hidden="true" t-esc="verdictIcon(kind)"/>
                                                <span class="o_rms_cs_row_model" t-att-class="scan.product_name ? '' : 'o_rms_cs_row_noproduct'"
                                                      t-esc="shortModel(scan)" t-att-title="scan.product_name or scan.code"/>
                                                <span class="o_rms_cs_row_serial" t-esc="scan.lot_name or scan.code"/>
                                                <span class="o_rms_cs_row_reason" t-esc="shortReason(scan, kind)"/>
                                            </div>
                                            <div class="o_rms_cs_row_state o_rms_cs_keep_focus">
                                                <select t-if="['serial', 'product'].includes(scan.type)" class="form-select form-select-sm"
                                                        aria-label="Estado de esta lectura"
                                                        t-on-change="(ev) => this.changeScanState(scan.id, ev.target.value)">
                                                    <option t-foreach="os.product_states" t-as="rowState" t-key="rowState.id"
                                                            t-att-value="rowState.id" t-att-selected="rowState.id === scan.product_state_id"
                                                            t-esc="rowState.name"/>
                                                </select>
                                                <span t-else="" class="o_rms_cs_row_state_text" t-esc="scan.product_state_name"/>
                                            </div>
                                            <div t-if="state.expandedId === scan.id" class="o_rms_cs_row_detail o_rms_cs_keep_focus">
                                                <t t-set="full" t-value="verdictFor({scan: scan})"/>
                                                <div class="fw-bold" t-esc="scan.product_name or scan.code"/>
                                                <div t-if="full.text"><t t-esc="full.text"/><t t-if="full.detail"> · <t t-esc="full.detail"/></t></div>
                                                <div t-if="scan.type === 'unknown'"><strong>Pendiente de revisar: </strong><t t-esc="scan.message"/></div>
                                                <div t-elif="scan.message and scan.message !== full.text" class="text-muted" t-esc="scan.message"/>
                                                <div class="o_rms_cs_row_actions">
                                                    <span class="text-muted">Leído a las <t t-esc="scan.time"/> · código <t t-esc="scan.code"/></span>
                                                    <button class="btn btn-sm btn-outline-danger" title="Borrar lectura"
                                                            t-on-click="() => this.deleteScan(scan.id)"><i class="fa fa-trash"/> Borrar</button>
                                                </div>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </section>
                    </div>
                    <div class="o_rms_cs_footer o_rms_cs_keep_focus">
                        <button class="btn btn-secondary" t-on-click="backToSession">Salir</button>
                        <button class="btn btn-success flex-grow-1" t-on-click="finish">He terminado mi recorrido</button>
                    </div>
                </t>
            </t>

            <t t-if="state.step === 'finished'">
                <div class="p-4 text-center">
                    <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                    <h4>Recorrido terminado</h4>
                    <div t-if="state.missing" class="text-start o_rms_cs_missing">
                        <h5>FALTAN <t t-esc="state.missing.count || 0"/> de Sage <t t-esc="state.missing.site"/></h5>
                        <ul class="list-group mb-3">
                            <li t-foreach="state.missing.missing || []" t-as="item" t-key="item_index" class="list-group-item">
                                <strong t-esc="item.model"/>
                                <div t-if="item.count_by_quantity">contar</div>
                                <div t-foreach="item.serials || []" t-as="serial" t-key="serial_index" t-esc="serial"/>
                            </li>
                        </ul>
                        <button t-if="state.operatorState and state.operatorState.session.state === 'counting'" class="btn btn-primary w-100 mb-3" t-on-click="startSearch">Ir a buscar</button>
                    </div>
                    <p class="text-muted">
                        Tus lecturas están guardadas. Cuando todos terminen, el responsable pulsa
                        "Terminar recuento y cruzar" en el recuento.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button t-if="state.operatorState and state.operatorState.session.state === 'counting'"
                                class="btn btn-outline-primary"
                                t-on-click="() => this.join(state.operatorState.operator.name)">
                            Seguir escaneando
                        </button>
                        <button class="btn btn-primary" t-on-click="backToSession">Volver al recuento</button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
