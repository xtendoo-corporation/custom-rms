<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sage_snapshot_list" model="ir.ui.view"><field name="name">rms.sage.snapshot.list</field><field name="model">rms.sage.snapshot</field><field name="arch" type="xml">
        <list create="false"><field name="name"/><field name="sage_company_code"/><field name="company_id" groups="base.group_multi_company"/><field name="brand_categ_id"/><field name="export_date"/><field name="state" widget="badge"/><field name="line_count"/><field name="unit_count"/><field name="unmatched_count"/><field name="total_cost" groups="rms_stock_count_session.group_sage_cost"/></list>
    </field></record>
    <record id="view_sage_snapshot_form" model="ir.ui.view"><field name="name">rms.sage.snapshot.form</field><field name="model">rms.sage.snapshot</field><field name="arch" type="xml">
        <form create="false" edit="false"><sheet><group><field name="name"/><field name="sage_company_code"/><field name="company_id"/><field name="brand_categ_id"/><field name="export_date"/><field name="state"/><field name="uploaded_by"/><field name="filename"/><field name="attachment" filename="filename" groups="stock.group_stock_manager"/><field name="file_hash"/><field name="line_count"/><field name="unit_count"/><field name="unmatched_count"/><field name="total_cost" groups="rms_stock_count_session.group_sage_cost"/></group><field name="quality_warnings"/><field name="line_ids" readonly="1"/></sheet></form>
    </field></record>
    <record id="view_sage_stock_line_list" model="ir.ui.view"><field name="name">rms.sage.stock.line.list</field><field name="model">rms.sage.stock.line</field><field name="arch" type="xml">
        <list create="false" edit="false" delete="false" decoration-warning="match_state != 'ok'" decoration-danger="dup_count &gt; 1"><field name="sage_company_code"/><field name="brand_categ_id"/><field name="warehouse_code"/><field name="article_code"/><field name="model_code"/><field name="state"/><field name="serial"/><field name="quantity"/><field name="cost" groups="rms_stock_count_session.group_sage_cost"/><field name="product_id"/><field name="match_state"/><field name="dup_count"/><button name="action_assign_product" type="object" string="Asignar" icon="fa-link" groups="stock.group_stock_manager"/></list>
    </field></record>
    <record id="view_sage_stock_line_search" model="ir.ui.view"><field name="name">rms.sage.stock.line.search</field><field name="model">rms.sage.stock.line</field><field name="arch" type="xml"><search><field name="article_code"/><field name="serial"/><field name="model_code"/><field name="product_id"/><field name="brand_categ_id"/><filter name="duplicates" string="Duplicados" domain="[('dup_count', '&gt;', 1)]"/><filter name="unmatched" string="Sin producto" domain="[('match_state', '!=', 'ok')]"/><group><filter name="by_article" string="Artículo" context="{'group_by':'article_code'}"/><filter name="by_brand" string="Marca" context="{'group_by':'brand_categ_id'}"/><filter name="by_warehouse" string="Almacén" context="{'group_by':'warehouse_code'}"/></group></search></field></record>
    <record id="view_sage_warehouse_list" model="ir.ui.view"><field name="name">rms.sage.warehouse.list</field><field name="model">rms.sage.warehouse</field><field name="arch" type="xml"><list editable="bottom"><field name="sage_company_code"/><field name="code"/><field name="name"/><field name="company_id"/><field name="location_id"/></list></field></record>
    <record id="view_sage_article_assign_form" model="ir.ui.view"><field name="name">rms.sage.article.assign.form</field><field name="model">rms.sage.article.assign</field><field name="arch" type="xml"><form><group><field name="article_code"/><field name="product_tmpl_id"/></group><footer><button name="action_assign" type="object" string="Asignar" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
    <record id="action_sage_import" model="ir.actions.act_window"><field name="name">Cargar exportación</field><field name="res_model">rms.stock.count.sage.import</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="action_sage_snapshots" model="ir.actions.act_window"><field name="name">Carpeta Sage</field><field name="res_model">rms.sage.snapshot</field><field name="view_mode">list,form</field></record>
    <record id="action_sage_stock" model="ir.actions.act_window"><field name="name">Existencias Sage</field><field name="res_model">rms.sage.stock.line</field><field name="view_mode">list,form</field><field name="domain">[('is_current', '=', True)]</field></record>
    <record id="action_sage_unmatched" model="ir.actions.act_window"><field name="name">Artículos sin producto</field><field name="res_model">rms.sage.stock.line</field><field name="view_mode">list,form</field><field name="domain">[('is_current', '=', True), ('match_state', '!=', 'ok')]</field><field name="context">{'search_default_by_article': 1}</field></record>
    <record id="action_sage_warehouses" model="ir.actions.act_window"><field name="name">Almacenes Sage</field><field name="res_model">rms.sage.warehouse</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_sage_root" name="Inventario Sage" sequence="25" groups="stock.group_stock_user"/>
    <menuitem id="menu_sage_counts" name="Recuentos" parent="menu_sage_root" action="action_stock_count_session" sequence="10"/>
    <menuitem id="menu_sage_folder" name="Carpeta Sage" parent="menu_sage_root" action="action_sage_snapshots" sequence="20" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sage_upload" name="Cargar exportación" parent="menu_sage_root" action="action_sage_import" sequence="21" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sage_stock" name="Existencias Sage" parent="menu_sage_root" action="action_sage_stock" sequence="30" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sage_unmatched" name="Artículos sin producto" parent="menu_sage_root" action="action_sage_unmatched" sequence="40" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sage_warehouses" name="Almacenes Sage" parent="menu_sage_root" action="action_sage_warehouses" sequence="50" groups="stock.group_stock_manager"/>
</odoo>
