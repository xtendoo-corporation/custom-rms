<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rms_sage_article_list" model="ir.ui.view">
        <field name="name">rms.sage.article.list</field>
        <field name="model">rms.sage.article</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="brand_name" readonly="1"/>
                <field name="brand_categ_id" options="{'no_create': True}"/>
                <field name="family_name" readonly="1"/>
                <field name="subfamily_name" readonly="1" optional="hide"/>
                <field name="state_prefix" readonly="1"/>
                <field name="discontinued" readonly="1"/>
                <field name="discontinued_date" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rms_sage_article_search" model="ir.ui.view">
        <field name="name">rms.sage.article.search</field>
        <field name="model">rms.sage.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="brand_name"/>
                <field name="family_name"/>
                <filter name="demo" string="D- (Demo / Ex-Demo)" domain="[('state_prefix', '=', 'demo')]"/>
                <filter name="second" string="2M- (2ª mano)" domain="[('state_prefix', '=', '2mano')]"/>
                <separator/>
                <filter name="active_articles" string="No de baja" domain="[('discontinued', '=', False)]"/>
                <filter name="discontinued" string="De baja" domain="[('discontinued', '=', True)]"/>
                <group>
                    <filter name="by_brand" string="Marca" context="{'group_by': 'brand_name'}"/>
                    <filter name="by_family" string="Familia" context="{'group_by': 'family_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sage_articles" model="ir.actions.act_window">
        <field name="name">Maestro de artículos Sage</field>
        <field name="res_model">rms.sage.article</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Carga el maestro de artículos de Sage</p>
            <p>Sage &gt; Artículos &gt; Exportar a Excel. Da la marca real a cada artículo.</p>
        </field>
    </record>

    <record id="view_rms_sage_article_import_form" model="ir.ui.view">
        <field name="name">rms.sage.article.import.form</field>
        <field name="model">rms.sage.article.import</field>
        <field name="arch" type="xml">
            <form string="Cargar maestro de artículos de Sage">
                <p>Exportación del maestro de artículos de Sage (Excel o CSV). Es el mismo en las tres
                    empresas: basta con cargar uno. Se puede volver a cargar cuando cambie; se actualiza.</p>
                <group>
                    <field name="file_data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Cargar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sage_article_import" model="ir.actions.act_window">
        <field name="name">Cargar maestro de artículos</field>
        <field name="res_model">rms.sage.article.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sage_articles" name="Maestro de artículos" parent="menu_sage_root"
              action="action_sage_articles" sequence="45" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sage_article_import" name="Cargar maestro de artículos" parent="menu_sage_root"
              action="action_sage_article_import" sequence="22" groups="stock.group_stock_manager"/>
</odoo>
