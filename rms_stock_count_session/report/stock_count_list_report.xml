<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Imprimir lista" del escáner: packing list de la nave que se cuenta.
         Sin enlace al menú Imprimir: solo se abre desde el botón de la Lista. -->
    <record id="paperformat_count_list" model="report.paperformat">
        <field name="name">Lista de la nave (A4, márgenes estrechos)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_count_list" model="ir.actions.report">
        <field name="name">Lista de la nave (recuento)</field>
        <field name="model">rms.stock.count.operator</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rms_stock_count_session.report_count_list</field>
        <field name="report_file">rms_stock_count_session.report_count_list</field>
        <field name="print_report_name">'Lista de la nave - %s' % (object.session_id.name)</field>
        <field name="paperformat_id" ref="paperformat_count_list"/>
    </record>

    <!-- Estilos EN LÍNEA: en el servidor el CSS estándar de los informes no
         siempre carga. Sin cantidades de Sage: recuento a ciegas. -->
    <template id="report_count_list">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="docs[0]"/>
                <t t-set="th" t-value="'border-bottom:2px solid #000;padding:4px 6px;text-align:left;font-size:11px;'"/>
                <t t-set="td" t-value="'border-bottom:1px solid #999;padding:5px 6px;font-size:12px;vertical-align:middle;'"/>
                <div class="page" style="font-family:Arial,Helvetica,sans-serif;color:#000;font-size:12px;">
                    <div style="border-bottom:3px solid #000;padding-bottom:6px;margin-bottom:10px;">
                        <div style="font-size:20px;font-weight:bold;">
                            <t t-if="only_pending">Lo que falta por leer</t><t t-else="">Lista completa</t>
                            · <span t-esc="lista['site'] or o.session_id.location_id.display_name"/>
                        </div>
                        <div style="font-size:12px;margin-top:2px;">
                            Recuento <b t-esc="o.session_id.name"/> · impreso el <span t-esc="printed_at"/> por <span t-esc="o.name"/>
                            · leídos <b t-esc="lista['counted']"/> de <b t-esc="lista['total']"/> equipos con nº de serie
                        </div>
                    </div>
                    <div t-if="not lista['groups']" style="font-size:14px;padding:20px 0;">
                        <t t-if="only_pending">No falta nada por leer.</t><t t-else="">Sage no tiene nada en esta nave.</t>
                    </div>
                    <div t-if="lista['truncated']" style="border:2px solid #000;padding:6px;margin-bottom:10px;font-weight:bold;">
                        La lista es muy larga y está cortada: imprímela marca a marca.
                    </div>
                    <t t-foreach="lista['groups']" t-as="group">
                        <table style="width:100%;border-collapse:collapse;margin-top:14px;page-break-after:avoid;">
                            <tr>
                                <td style="background-color:#000;color:#fff;font-size:15px;font-weight:bold;padding:5px 8px;" t-esc="group['name']"/>
                                <td style="background-color:#000;color:#fff;font-size:12px;padding:5px 8px;text-align:right;white-space:nowrap;width:30%;">
                                    leídos <t t-esc="group['counted']"/> de <t t-esc="group['total']"/> con nº de serie
                                </td>
                            </tr>
                        </table>
                        <table t-if="group['products']" style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th t-att-style="th + 'width:18%;'">Referencia</th>
                                    <th t-att-style="th + 'width:34%;'">Producto</th>
                                    <th t-att-style="th + 'width:26%;'">Nº de serie</th>
                                    <th t-att-style="th + 'width:15%;'">Sage</th>
                                    <th t-att-style="th + 'width:7%;text-align:center;'">Leído</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="group['products']" t-as="product">
                                    <tr t-foreach="product['rows']" t-as="row" style="page-break-inside:avoid;">
                                        <td t-att-style="td + ('font-weight:bold;' if row_first else 'color:#777;')">
                                            <span t-esc="product['ref']"/>
                                        </td>
                                        <td t-att-style="td + ('font-weight:bold;' if row_first else 'color:#777;')">
                                            <span t-esc="product['name']"/>
                                            <span t-if="row_first and len(product['rows']) > 1" style="font-weight:normal;"> (<t t-esc="len(product['rows'])"/>)</span>
                                        </td>
                                        <td t-att-style="td + 'font-family:Courier,monospace;font-size:13px;font-weight:bold;'" t-esc="row['serial']"/>
                                        <td t-att-style="td + 'font-size:10px;'"><t t-esc="row['company']"/> · <t t-esc="row['state']"/></td>
                                        <td t-att-style="td + 'text-align:center;'">
                                            <span t-if="row['k'] == 'todo'" style="display:inline-block;width:14px;height:14px;border:1.5px solid #000;"/>
                                            <span t-else="" style="display:inline-block;width:14px;height:14px;border:1.5px solid #000;background-color:#000;color:#fff;font-size:11px;line-height:14px;font-weight:bold;">X</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-if="group['qty']">
                            <div style="font-weight:bold;font-size:12px;margin-top:8px;padding:3px 6px;border-bottom:2px solid #000;page-break-after:avoid;">
                                Por cantidad (sin nº de serie): cuenta las unidades y apúntalas
                            </div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tbody>
                                    <tr t-foreach="group['qty']" t-as="item" style="page-break-inside:avoid;">
                                        <td t-att-style="td + 'width:18%;font-weight:bold;'" t-esc="item['ref']"/>
                                        <td t-att-style="td + 'width:52%;'" t-esc="item['name']"/>
                                        <td t-att-style="td + 'width:30%;'">
                                            <t t-if="item['counted']">Ya apuntado: <b t-esc="item['counted']"/></t>
                                            <t t-else="">Contado: ____________</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>
                    <div style="margin-top:14px;font-size:10px;color:#444;">
                        No salen en esta lista los equipos que Sage tiene en depósito en clientes ni los que Sage tiene en otra nave.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
