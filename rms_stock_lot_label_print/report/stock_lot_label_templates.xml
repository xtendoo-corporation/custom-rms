<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Etiqueta 50x29 mm (cinta continua Brother de 29 mm cortada a 50 mm):
        modelo del producto en grande (lo que se busca en la estantería), estado si
        no es "Nuevo" (DEMO, 2ª MANO...), descripción, código de barras
        Code128 del número de serie (lo que se escanea) y el número de serie
        en texto, todo centrado en vertical. Sin línea de "etiqueta sustituta"
        (Administración, 10-nov-2026). La página se gira 90 grados al generar
        el PDF (models/ir_actions_report.py) para la cinta de 29 mm.

        Maquetación con tablas en mm (wkhtmltopdf no entiende flex); el formato
        de papel lleva disable_shrinking para que los mm sean exactos. El salto
        de página solo va entre etiquetas (si no, salen pegatinas en blanco).
    -->
    <template id="report_lot_label_10x5_document">
        <t t-call="web.html_container">
            <t t-set="labels" t-value="[(o, n) for o in docs for n in range(copies or 1)]"/>
            <!-- Sin div.article, Odoo manda el HTML sin <meta charset> a
                 wkhtmltopdf y los acentos salen mal ("2Âª MANO"). -->
            <div class="article">
            <!-- La plantilla base de Odoo pone el body como "container" (con
                 relleno lateral): aquí no, el hueco ya lo dan los márgenes. -->
            <style>
                html, body, body.container, .article {
                    margin: 0 !important; padding: 0 !important;
                    max-width: none !important; width: auto !important;
                }
            </style>
            <t t-foreach="labels" t-as="label">
                <t t-set="o" t-value="label[0]"/>
                <t t-set="state" t-value="o.product_state_id if 'product_state_id' in o._fields else False"/>
                <!-- En grande el modelo: lo que hay antes del primer " - " del
                     nombre (p. ej. "UPA-1P - Caja compacta..."); debajo, en
                     pequeño, la referencia y el resto de la descripción. -->
                <t t-set="name_parts" t-value="(o.product_id.name or '').split(' - ', 1)"/>
                <t t-set="model" t-value="name_parts[0].strip() or o.product_id.default_code or ''"/>
                <t t-set="show_state" t-value="bool(state and state.code != 'new')"/>
                <!-- El modelo se reduce si es largo (hay menos sitio si va el estado). -->
                <t t-set="model_len" t-value="len(model) + (5 if show_state else 0)"/>
                <t t-set="model_size" t-value="'14pt' if model_len &lt;= 13 else ('12pt' if model_len &lt;= 16 else '10pt')"/>
                <!-- El S/N se reduce si es largo, para que quepa entero. -->
                <t t-set="sn_len" t-value="len(o.name or '')"/>
                <t t-set="sn_size" t-value="'11pt' if sn_len &lt;= 15 else ('9.5pt' if sn_len &lt;= 18 else '8pt')"/>
                <t t-set="detail" t-value="' · '.join(x for x in [o.product_id.default_code or '', name_parts[1].strip() if len(name_parts) &gt; 1 else ''] if x)"/>
                <!-- Hueco útil 47 x 26 mm (50 x 29 menos 1,5 mm de margen) con el
                     contenido centrado en vertical: mismo margen arriba que abajo. -->
                <div t-att-style="'width:47mm;height:25.5mm;overflow:hidden;font-family:Arial, sans-serif;'
                                  + ('' if label_last else 'page-break-after:always;')">
                    <table style="width:47mm;height:25.5mm;border-collapse:collapse;">
                        <tr>
                            <td style="vertical-align:middle;padding:0;">
                                <table style="width:47mm;border-collapse:collapse;table-layout:fixed;">
                                    <tr>
                                        <!-- Sin recuadro de estado (Nuevo) el modelo ocupa todo el ancho:
                                             con table-layout fixed se quedaba en media etiqueta ("GALAXY 8"). -->
                                        <td t-att-colspan="None if show_state else 2"
                                            t-attf-style="font-size:{{ model_size }};line-height:1.05;font-weight:bold;white-space:nowrap;overflow:hidden;padding:0;">
                                            <t t-esc="model"/>
                                        </td>
                                        <td t-if="show_state"
                                            style="width:15mm;text-align:right;vertical-align:middle;padding:0;">
                                            <span style="font-size:8pt;font-weight:bold;border:0.35mm solid #000;
                                                         padding:0 0.6mm;text-transform:uppercase;white-space:nowrap;">
                                                <t t-esc="state.name"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="font-size:7pt;line-height:1.15;white-space:nowrap;overflow:hidden;padding:0 0 0.6mm 0;">
                                            <t t-esc="detail"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="text-align:center;padding:0;">
                                            <img t-if="o.rms_label_barcode_image"
                                                 t-att-src="image_data_uri(o.rms_label_barcode_image)"
                                                 style="width:44mm;height:12mm;display:block;margin:0 auto;"/>
                                            <div t-if="not o.rms_label_barcode_image" style="font-size:6.5pt;color:#b00;">
                                                No se pudo generar el código de barras.
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" t-attf-style="text-align:center;font-size:{{ sn_size }};line-height:1.1;font-weight:bold;white-space:nowrap;overflow:hidden;padding:0.9mm 0 0 0;">
                                            S/N: <t t-esc="o.name"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            </div>
        </t>
    </template>
</odoo>
