<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Etiqueta 50x29 mm (cinta continua Brother de 29 mm cortada a 50 mm):
        modelo del producto en grande (lo que se busca en la estantería), estado si
        no es "Nuevo" (DEMO, 2ª MANO...), descripción, código de barras
        Code128 del número de serie (lo que se escanea) y el número de serie
        en texto. Si es una etiqueta sustituta, una línea al pie lo indica.

        Maquetación con tabla y anchos en %: wkhtmltopdf no entiende flex y
        reduce las medidas en mm. El salto de página solo va entre etiquetas
        (si no, salen pegatinas en blanco en la impresora).
    -->
    <template id="report_lot_label_10x5_document">
        <t t-call="web.html_container">
            <t t-set="labels" t-value="[(o, n) for o in docs for n in range(copies or 1)]"/>
            <!-- Sin div.article, Odoo manda el HTML sin <meta charset> a
                 wkhtmltopdf y los acentos salen mal ("2Âª MANO"). -->
            <div class="article">
            <t t-foreach="labels" t-as="label">
                <t t-set="o" t-value="label[0]"/>
                <t t-set="state" t-value="o.product_state_id if 'product_state_id' in o._fields else False"/>
                <!-- En grande el modelo: lo que hay antes del primer " - " del
                     nombre (p. ej. "UPA-1P - Caja compacta..."); debajo, en
                     pequeño, la referencia y el resto de la descripción. -->
                <t t-set="name_parts" t-value="(o.product_id.name or '').split(' - ', 1)"/>
                <t t-set="model" t-value="name_parts[0].strip() or o.product_id.default_code or ''"/>
                <t t-set="detail" t-value="' · '.join(x for x in [o.product_id.default_code or '', name_parts[1].strip() if len(name_parts) &gt; 1 else ''] if x)"/>
                <div t-att-style="'width:100%;overflow:hidden;font-family:Arial, sans-serif;line-height:1.05;'
                                  + ('' if label_last else 'page-break-after:always;')">
                    <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                        <tr>
                            <td style="font-size:15px;font-weight:bold;white-space:nowrap;overflow:hidden;vertical-align:top;">
                                <t t-esc="model"/>
                            </td>
                            <td t-if="state and state.code != 'new'"
                                style="width:30%;text-align:right;vertical-align:top;">
                                <span style="font-size:10px;font-weight:bold;border:1.5px solid #000;
                                             padding:0 2px;text-transform:uppercase;white-space:nowrap;">
                                    <t t-esc="state.name"/>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="font-size:8px;white-space:nowrap;overflow:hidden;padding-bottom:2px;">
                                <t t-esc="detail"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align:center;">
                                <img t-if="o.rms_label_barcode_image"
                                     t-att-src="image_data_uri(o.rms_label_barcode_image)"
                                     style="width:94%;height:13mm;"/>
                                <div t-if="not o.rms_label_barcode_image" style="font-size:8px;color:#b00;">
                                    No se pudo generar el código de barras.
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align:center;font-size:11px;font-weight:bold;white-space:nowrap;overflow:hidden;">
                                S/N: <t t-esc="o.name"/>
                            </td>
                        </tr>
                        <tr t-if="o.rms_replacement_label">
                            <td colspan="2" style="font-size:6px;text-align:center;color:#333;white-space:nowrap;overflow:hidden;">
                                Etiqueta sustituta <t t-esc="o.company_id.name or env.company.name"/>
                                <t t-if="o.rms_label_printed_date">
                                    - <t t-esc="context_timestamp(o.rms_label_printed_date).strftime('%d/%m/%Y')"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            </div>
        </t>
    </template>
</odoo>
