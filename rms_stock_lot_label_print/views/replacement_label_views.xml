<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rms_lot_label_wizard_form" model="ir.ui.view">
        <field name="name">rms.lot.label.wizard.form</field>
        <field name="model">rms.lot.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Etiqueta sustituta">
                <p class="text-muted">
                    Para equipos con el número de serie grabado en la placa, con la etiqueta
                    del fabricante dañada o sin caja original: se da de alta el número de serie
                    (si no existe) y se imprime una etiqueta con la referencia y el número de
                    serie en código de barras. Pégala en el equipo o en la caja, sin tapar la
                    etiqueta original (algunos fabricantes anulan la garantía).
                </p>
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="default_code"/>
                        <field name="reason"/>
                        <field name="product_state_id" options="{'no_create': True}"/>
                        <field name="copies"/>
                    </group>
                    <group>
                        <field name="serial_text"
                               placeholder="Uno por línea (varios si la caja trae varios equipos)"/>
                        <field name="serial_count" invisible="1"/>
                        <field name="serial_confirm" invisible="serial_count != 1"
                               required="serial_count == 1"/>
                    </group>
                </group>
                <field name="preview" invisible="not preview" readonly="1"/>
                <footer>
                    <button name="action_create_and_print" type="object" string="Crear e imprimir"
                            class="btn-primary" icon="fa-print"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rms_lot_label_wizard" model="ir.actions.act_window">
        <field name="name">Etiqueta sustituta</field>
        <field name="res_model">rms.lot.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_rms_lot_label_wizard"
        name="Etiqueta sustituta (nº de serie)"
        action="action_rms_lot_label_wizard"
        parent="stock.menu_stock_warehouse_mgmt"
        sequence="5"
        groups="stock.group_stock_user"
    />

    <record id="view_production_lot_form_rms_replacement_label" model="ir.ui.view">
        <field name="name">stock.lot.form.rms.replacement.label</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="inside">
                <group string="Etiqueta" name="rms_label">
                    <field name="rms_replacement_label"/>
                    <field name="rms_replacement_reason" invisible="not rms_replacement_label"/>
                    <field name="rms_label_printed_date" invisible="not rms_label_printed_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
