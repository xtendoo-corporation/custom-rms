<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_knowledge_contributor" model="res.groups">
        <field name="name">Knowledge Uploaders</field>
        <field name="privilege_id" eval="False"/>
    </record>

    <record id="group_knowledge_manager" model="res.groups">
        <field name="name">Knowledge Managers</field>
        <field name="privilege_id" eval="False"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="document_knowledge.group_document_user" model="res.groups">
        <field name="privilege_id" eval="False"/>
    </record>

    <record id="document_knowledge.group_ir_attachment_user" model="res.groups">
        <field name="privilege_id" eval="False"/>
    </record>

    <!-- Clean up old rules -->
    <delete model="ir.rule" search="[('name', 'in', [
        'Knowledge directory access: users read own permissions',
        'Knowledge directory access: managers full access',
        'Knowledge directory access: administrators full access',
        'Knowledge directories: restricted users explicit read',
        'Knowledge directories: managers full access',
        'Knowledge directories: uploaders global access',
        'Knowledge documents: restricted users explicit read',
        'Knowledge documents: restricted users explicit upload',
        'Knowledge documents: managers full access',
        'Knowledge documents: uploaders global read and upload'
    ])]"/>

    <!-- Access Rules for document.knowledge.access -->
    <record id="access_document_knowledge_access_manager" model="ir.model.access">
        <field name="name">document.knowledge.access.manager</field>
        <field name="model_id" ref="model_document_knowledge_access"/>
        <field name="group_id" ref="rms_custom_knowledge.group_knowledge_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_document_knowledge_access_system" model="ir.model.access">
        <field name="name">document.knowledge.access.system</field>
        <field name="model_id" ref="model_document_knowledge_access"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_document_knowledge_access_internal_all_read" model="ir.rule">
        <field name="name">Knowledge directory access: internal users read all permissions</field>
        <field name="model_id" ref="model_document_knowledge_access"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- General DB rules for categories and attachments. Custom permissions logic is handled in Python. -->
    <record id="rule_document_knowledge_category_internal_all" model="ir.rule">
        <field name="name">Knowledge directories: internal users database access</field>
        <field name="model_id" ref="model_document_knowledge_category"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_knowledge_pdf_internal_all" model="ir.rule">
        <field name="name">Knowledge documents: internal users database access</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[('is_knowledge_document', '=', True)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
