<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="onlyoffice_editor_page" name="OnlyOffice Editor">
        <html>
            <head>
                <meta charset="utf-8"/>
                <title><t t-esc="title"/></title>
                <script t-att-src="server_url + '/web-apps/apps/api/documents/api.js'"></script>
                <style>
                    html, body { margin: 0; height: 100%; }
                    #onlyoffice-editor { width: 100%; height: 100vh; }
                </style>
            </head>
            <body>
                <div id="onlyoffice-editor"/>
                <script t-raw="'var docEditor = new DocsAPI.DocEditor(\'onlyoffice-editor\', ' + config_json + ');'"/>
            </body>
        </html>
    </template>

    <template id="onlyoffice_editor_error" name="OnlyOffice Editor Error">
        <html>
            <head>
                <meta charset="utf-8"/>
            </head>
            <body style="font-family: sans-serif; padding: 40px; text-align: center;">
                <h3><t t-esc="message"/></h3>
            </body>
        </html>
    </template>
</odoo>
