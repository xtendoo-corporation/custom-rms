<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_serial_selector_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.line.serial.selector.wizard.form</field>
        <field name="model">sale.order.line.serial.selector.wizard</field>
        <field name="arch" type="xml">
            <form string="Vender como 2ª Mano / Ex-Demo">
                <field name="sale_order_line_id" invisible="1"/>
                <field name="unavailable_lot_ids" invisible="1"/>
                <group>
                    <field name="product_id"/>
                    <field name="state_code" widget="radio"/>
                </group>
                <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <p class="text-muted">
                    Solo se muestran los números de serie de este producto, en el estado elegido,
                    que no estén ya asignados en otro presupuesto/pedido activo.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button name="action_clear" type="object" string="Quitar todas las series"
                            confirm="¿Seguro que quieres quitar todos los números de serie de esta línea?"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_order_form_inherit_rms_product_state" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rms.product.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="serial_count" string="Nº Series" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <button name="action_open_serial_selector" type="object"
                        string="2ª Mano / Ex-Demo" icon="fa-barcode"
                        invisible="not product_id"
                        title="Seleccionar números de serie 2ª Mano / Ex-Demo"/>
            </xpath>
        </field>
    </record>
</odoo>
