<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="serial_company_rule" model="ir.rule">
        <field name="name">Series: compañías permitidas</field>
        <field name="model_id" ref="model_sale_order_line_serial"/>
        <field name="domain_force">[('sale_order_line_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="serial_salesman_rule" model="ir.rule">
        <field name="name">Series: documentos propios</field>
        <field name="model_id" ref="model_sale_order_line_serial"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">['|', ('sale_order_line_id.order_id.user_id', '=', user.id), ('sale_order_line_id.order_id.user_id', '=', False)]</field>
    </record>
    <record id="serial_sales_all_rule" model="ir.rule">
        <field name="name">Series: todos los documentos de ventas</field>
        <field name="model_id" ref="model_sale_order_line_serial"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="serial_stock_rule" model="ir.rule">
        <field name="name">Series: lectura para reservas de inventario</field>
        <field name="model_id" ref="model_sale_order_line_serial"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
