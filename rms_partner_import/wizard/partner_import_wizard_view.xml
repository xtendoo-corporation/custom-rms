<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rms_partner_import_wizard" model="ir.ui.view">
        <field name="name">rms.partner.import.wizard.form</field>
        <field name="model">rms.partner.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Contactos (Excel)">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" widget="binary"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rms_partner_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Contactos (RMS)</field>
        <field name="res_model">rms.partner.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_rms_partner_import"
              name="Importar Contactos (RMS)"
              parent="contacts.res_partner_menu_config"
              action="action_rms_partner_import_wizard"
              sequence="100"/>
</odoo>
