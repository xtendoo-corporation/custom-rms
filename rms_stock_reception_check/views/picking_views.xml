<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_reception_required" model="ir.ui.view">
        <field name="name">stock.picking.form.rms.reception.required</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="rms_reception_mandatory" invisible="1"/>
                <button name="action_rms_skip_reception" type="object" string="Validar sin recepción"
                        groups="stock.group_stock_manager"
                        invisible="not rms_reception_mandatory or state in ('draft', 'done', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_type_form_reception_required" model="ir.ui.view">
        <field name="name">stock.picking.type.form.rms.reception.required</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="rms_reception_required" invisible="code != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <record id="view_rms_reception_skip_wizard_form" model="ir.ui.view">
        <field name="name">rms.reception.skip.wizard.form</field>
        <field name="model">rms.reception.skip.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar sin recepción">
                <p>Vas a validar este albarán de entrada sin pasar por «Recepción de proveedor». Queda escrito en el historial del albarán con tu nombre, la fecha y el motivo.</p>
                <group>
                    <field name="picking_id"/>
                    <field name="reason" placeholder="Por qué no se hace la recepción"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Validar sin recepción" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_picking_type_reception_required_list" model="ir.ui.view">
        <field name="name">stock.picking.type.list.rms.reception.required</field>
        <field name="model">stock.picking.type</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <list string="Recepción obligatoria por almacén" editable="bottom" create="0" delete="0">
                <field name="warehouse_id" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="rms_reception_required"/>
                <field name="company_id" groups="base.group_multi_company" optional="show" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_picking_type_reception_required" model="ir.actions.act_window">
        <field name="name">Recepción obligatoria por almacén</field>
        <field name="res_model">stock.picking.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_picking_type_reception_required_list"/>
        <field name="domain">[('code', '=', 'incoming')]</field>
    </record>

    <menuitem id="menu_picking_type_reception_required" name="Recepción obligatoria por almacén"
              parent="stock.menu_warehouse_config" sequence="31" action="action_picking_type_reception_required"
              groups="stock.group_stock_manager"/>
</odoo>
