<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_serials_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <div class="page">
                <h2>Números de serie entregados</h2>
                <div class="row mt-3 mb-3">
                    <div class="col-4"><strong>Albarán:</strong> <span t-field="o.name"/></div>
                    <div class="col-4"><strong>Pedido / origen:</strong> <span t-field="o.origin"/></div>
                    <div class="col-4"><strong>Fecha:</strong> <span t-field="o.date_done" t-options="{'widget': 'date'}"/></div>
                </div>
                <div class="mb-3" t-if="o.partner_id">
                    <strong>Cliente:</strong>
                    <span t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                </div>
                <p t-if="o.rms_check_kind in ('deposit_out', 'deposit_return')">
                    <strong t-if="o.rms_check_kind == 'deposit_out'">Material entregado en depósito: sigue siendo propiedad de <t t-out="o.company_id.name"/>.</strong>
                    <strong t-else="">Material devuelto de un depósito.</strong>
                </p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Nº de serie</th>
                            <th>Estado</th>
                            <th class="text-end">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_line_ids.filtered(lambda l: l.quantity).sorted(lambda l: (l.product_id.display_name, l.lot_id.name or ''))" t-as="line">
                            <td><span t-field="line.product_id.display_name"/></td>
                            <td><span t-out="line.lot_id.name or line.lot_name or '—'"/></td>
                            <td><span t-out="(line.product_state_id or line.lot_id.product_state_id).name or ''"/></td>
                            <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-muted" t-if="o.state != 'done'">Albarán todavía sin validar: la lista puede cambiar.</p>
            </div>
        </t>
    </template>

    <template id="report_delivery_serials">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="rms_stock_delivery_check.report_delivery_serials_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_delivery_serials" model="ir.actions.report">
        <field name="name">Nº de serie entregados (con estado)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rms_stock_delivery_check.report_delivery_serials</field>
        <field name="report_file">rms_stock_delivery_check.report_delivery_serials</field>
        <field name="print_report_name">'Números de serie - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
