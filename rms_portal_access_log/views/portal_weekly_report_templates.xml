<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_weekly_report_email">
        <div style="margin:0;padding:24px 0;background:#f2f4f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:760px;margin:0 auto;background:#ffffff;border-radius:8px;border-collapse:separate;">
            <tr><td style="padding:24px 28px 8px 28px;">
                <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.06em;">Portal de clientes · <t t-esc="company.name"/></div>
                <h1 style="margin:6px 0 4px 0;font-size:22px;color:#111827;">Resumen semanal</h1>
                <div style="font-size:14px;color:#4b5563;">Del <t t-esc="date_from"/> al <t t-esc="date_to"/></div>
            </td></tr>

            <!-- KPIs -->
            <tr><td style="padding:16px 20px 4px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="8">
                    <tr>
                        <t t-foreach="[
                            ('Clientes que han entrado', kpis['clients']),
                            ('Accesos', kpis['logins']),
                            ('Fichas vistas', kpis['cards']),
                            ('Consultas de precio', kpis['prices']),
                            ('Añadidos al presupuesto', kpis['quotes']),
                            ('Clientes calientes', kpis['hot']),
                        ]" t-as="kpi">
                            <td width="16%" style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:6px;padding:10px 8px;text-align:center;vertical-align:top;">
                                <div style="font-size:22px;font-weight:bold;color:#111827;"><t t-esc="kpi[1]"/></div>
                                <div style="font-size:11px;color:#6b7280;line-height:1.3;"><t t-esc="kpi[0]"/></div>
                            </td>
                        </t>
                    </tr>
                </table>
            </td></tr>

            <!-- Intereses destacados -->
            <tr><td style="padding:16px 28px 0 28px;">
                <h2 style="font-size:16px;margin:8px 0;color:#111827;">🔥 Oportunidades: dónde están más interesados</h2>
                <t t-if="not top_interests">
                    <p style="font-size:13px;color:#6b7280;margin:4px 0 8px 0;">Esta semana ningún cliente ha llegado a interés templado (40 %) o caliente (70 %).</p>
                </t>
                <t t-else="">
                    <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
                        <tr style="background:#f3f4f6;color:#374151;text-align:left;">
                            <th style="border-bottom:1px solid #e5e7eb;">Cliente</th>
                            <th style="border-bottom:1px solid #e5e7eb;">Ficha</th>
                            <th style="border-bottom:1px solid #e5e7eb;text-align:center;" title="Visitas / Precios / Presupuesto">Vis · Pre · Presup</th>
                            <th style="border-bottom:1px solid #e5e7eb;width:150px;">Interés</th>
                        </tr>
                        <t t-foreach="top_interests" t-as="row">
                            <tr>
                                <td style="border-bottom:1px solid #f0f0f0;"><t t-esc="row['partner']"/></td>
                                <td style="border-bottom:1px solid #f0f0f0;">
                                    <strong><t t-esc="row['card']"/></strong>
                                    <span t-if="row['brand']" style="color:#6b7280;"> · <t t-esc="row['brand']"/></span>
                                </td>
                                <td style="border-bottom:1px solid #f0f0f0;text-align:center;color:#4b5563;">
                                    <t t-esc="row['views']"/> · <t t-esc="row['prices']"/> · <t t-esc="row['quotes']"/>
                                </td>
                                <td style="border-bottom:1px solid #f0f0f0;">
                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
                                        <td style="background:#eef0f3;border-radius:3px;height:8px;">
                                            <div t-attf-style="width:{{ row['score'] }}%;height:8px;border-radius:3px;background:{{ row['level'][1] }};"></div>
                                        </td>
                                        <td width="70" t-attf-style="padding-left:8px;font-weight:bold;color:{{ row['level'][1] }};white-space:nowrap;">
                                            <t t-esc="row['score']"/> %
                                        </td>
                                    </tr></table>
                                    <div t-attf-style="font-size:11px;color:{{ row['level'][1] }};"><t t-esc="row['level'][0]"/></div>
                                </td>
                            </tr>
                        </t>
                    </table>
                </t>
            </td></tr>

            <!-- Clientes que han entrado -->
            <tr><td style="padding:20px 28px 0 28px;">
                <h2 style="font-size:16px;margin:8px 0;color:#111827;">👥 Clientes que han entrado</h2>
                <t t-if="not clients">
                    <p style="font-size:13px;color:#6b7280;margin:4px 0 8px 0;">Ningún cliente ha entrado en el portal esta semana.</p>
                </t>
                <t t-else="">
                    <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
                        <tr style="background:#f3f4f6;color:#374151;text-align:left;">
                            <th style="border-bottom:1px solid #e5e7eb;">Cliente</th>
                            <th style="border-bottom:1px solid #e5e7eb;">Comercial</th>
                            <th style="border-bottom:1px solid #e5e7eb;text-align:center;">Accesos</th>
                            <th style="border-bottom:1px solid #e5e7eb;text-align:center;">Fichas</th>
                            <th style="border-bottom:1px solid #e5e7eb;">Lo que más le interesa</th>
                            <th style="border-bottom:1px solid #e5e7eb;">Última vez</th>
                        </tr>
                        <t t-foreach="clients" t-as="c">
                            <tr>
                                <td style="border-bottom:1px solid #f0f0f0;"><strong><t t-esc="c['name']"/></strong></td>
                                <td style="border-bottom:1px solid #f0f0f0;color:#4b5563;"><t t-esc="c['salesperson']"/></td>
                                <td style="border-bottom:1px solid #f0f0f0;text-align:center;"><t t-esc="c['logins']"/></td>
                                <td style="border-bottom:1px solid #f0f0f0;text-align:center;"><t t-esc="c['cards']"/></td>
                                <td style="border-bottom:1px solid #f0f0f0;">
                                    <t t-if="c['top_card']">
                                        <t t-esc="c['top_card']"/>
                                        <span t-attf-style="display:inline-block;margin-left:4px;padding:1px 6px;border-radius:10px;font-size:11px;color:#ffffff;background:{{ c['top_level'][1] }};"><t t-esc="c['top_score']"/> %</span>
                                    </t>
                                    <span t-else="" style="color:#9ca3af;">Sin fichas vistas</span>
                                </td>
                                <td style="border-bottom:1px solid #f0f0f0;color:#4b5563;white-space:nowrap;"><t t-esc="c['last_seen']"/></td>
                            </tr>
                        </t>
                    </table>
                    <p t-if="more_clients" style="font-size:12px;color:#6b7280;margin:6px 0 0 0;">
                        …y <t t-esc="more_clients"/> clientes más. Consulta la lista completa en Odoo.
                    </p>
                </t>
            </td></tr>

            <!-- Fichas más vistas y búsquedas sin resultado -->
            <tr><td style="padding:20px 28px 0 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
                    <td width="58%" style="vertical-align:top;padding-right:12px;">
                        <h2 style="font-size:16px;margin:8px 0;color:#111827;">📈 Fichas más vistas</h2>
                        <t t-if="not top_cards"><p style="font-size:13px;color:#6b7280;margin:4px 0;">Sin visitas a fichas.</p></t>
                        <table t-else="" role="presentation" width="100%" cellpadding="5" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
                            <t t-foreach="top_cards" t-as="card">
                                <tr>
                                    <td style="border-bottom:1px solid #f0f0f0;">
                                        <t t-esc="card['card']"/>
                                        <span t-if="card['brand']" style="color:#6b7280;"> · <t t-esc="card['brand']"/></span>
                                    </td>
                                    <td style="border-bottom:1px solid #f0f0f0;text-align:right;white-space:nowrap;color:#4b5563;">
                                        <t t-esc="card['views']"/> visitas · <t t-esc="card['clients']"/> clientes
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </td>
                    <td width="42%" style="vertical-align:top;padding-left:12px;">
                        <h2 style="font-size:16px;margin:8px 0;color:#111827;">🔎 Buscado y no encontrado</h2>
                        <t t-if="not empty_searches"><p style="font-size:13px;color:#6b7280;margin:4px 0;">Ninguna búsqueda sin resultados.</p></t>
                        <table t-else="" role="presentation" width="100%" cellpadding="5" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
                            <t t-foreach="empty_searches" t-as="search">
                                <tr>
                                    <td style="border-bottom:1px solid #f0f0f0;">“<t t-esc="search[0]"/>”</td>
                                    <td style="border-bottom:1px solid #f0f0f0;text-align:right;color:#4b5563;"><t t-esc="search[1]"/>×</td>
                                </tr>
                            </t>
                        </table>
                    </td>
                </tr></table>
            </td></tr>

            <!-- Pie -->
            <tr><td style="padding:24px 28px 24px 28px;">
                <a t-att-href="interest_url" style="display:inline-block;background:#1f4e79;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-size:14px;">Ver intereses en Odoo</a>
                <p style="font-size:11px;color:#9ca3af;margin:16px 0 0 0;line-height:1.5;">
                    % de interés: visitas a la ficha (máx. 25) + consultas de precio (máx. 25) + añadidos al presupuesto (máx. 40)
                    + volver otros días (máx. 10). Cada acción pierde la mitad de su valor cada 30 días.
                    Caliente ≥ 70 % · Templado 40-69 % · Frío &lt; 40 %.<br/>
                    Recibes este correo porque tienes activado "Recibe el informe semanal del portal" en tu usuario.
                </p>
            </td></tr>
        </table>
        </div>
    </template>
</odoo>
