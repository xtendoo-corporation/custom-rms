<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_portal_access_log" model="ir.module.category">
        <field name="name">Accesos al Portal (RMS)</field>
    </record>

    <record id="res_groups_privilege_portal_weekly_report" model="res.groups.privilege">
        <field name="name">Informe semanal del portal</field>
        <field name="category_id" ref="module_category_portal_access_log"/>
    </record>

    <record id="group_portal_weekly_report" model="res.groups">
        <field name="name">Recibe el informe semanal del portal</field>
        <field name="privilege_id" ref="res_groups_privilege_portal_weekly_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Recibe cada lunes por email el resumen de clientes que han entrado en el portal y sus % de interés.</field>
    </record>
</odoo>
