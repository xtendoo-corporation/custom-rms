<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rms_hr_expense_quick_capture.QuickCapture">
        <div class="o_rms_quick_capture d-flex flex-column align-items-center justify-content-center h-100 w-100">
            <input type="file" accept="image/*" capture="environment"
                   t-ref="fileInput" class="d-none" t-on-change="onFileChange"/>

            <t t-if="state.phase === 'idle'">
                <button class="o_rms_quick_capture_button btn btn-primary rounded-circle"
                        t-on-click="openCamera">
                    <i class="fa fa-camera"/>
                </button>
                <div class="mt-4 fs-4 fw-bold text-center">Hacer foto del ticket</div>
            </t>

            <t t-if="state.phase === 'uploading'">
                <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                <div class="mt-4 fs-4 text-center">Subiendo la foto…</div>
            </t>

            <t t-if="state.phase === 'done'">
                <i class="fa fa-check-circle fa-3x text-success"/>
                <div class="mt-3 fs-4 fw-bold text-center">¡Foto subida!</div>
                <div class="mt-2 text-center text-muted">
                    Se ha creado el gasto en borrador. La IA lo procesará en
                    unos minutos (fecha, importe, proveedor y categoría).
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-secondary" t-on-click="openExpense">Ver gasto</button>
                    <button class="btn btn-primary" t-on-click="reset">Hacer otro ticket</button>
                </div>
            </t>

            <t t-if="state.phase === 'error'">
                <i class="fa fa-exclamation-triangle fa-3x text-danger"/>
                <div class="mt-3 fs-5 text-center text-danger">
                    <t t-esc="state.error"/>
                </div>
                <button class="btn btn-primary mt-4" t-on-click="reset">Reintentar</button>
            </t>
        </div>
    </t>
</templates>
